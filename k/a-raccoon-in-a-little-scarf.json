{"id": "sketch-a-raccoon-in-a-little-scarf", "title": "Raccoon in a little scarf", "blurb": "", "svg": "<svg viewBox='0 0 100 100' xmlns='http://www.w3.org/2000/svg'>\n  <!-- ears -->\n  <polygon points='22,28 30,12 40,26' fill='#8a8f9c'/>\n  <polygon points='26,25 31,17 37,25' fill='#d98ba8'/>\n  <polygon points='78,28 70,12 60,26' fill='#8a8f9c'/>\n  <polygon points='74,25 69,17 63,25' fill='#d98ba8'/>\n\n  <!-- head -->\n  <ellipse cx='50' cy='42' rx='32' ry='27' fill='#9aa0ad'/>\n\n  <!-- cheek fur -->\n  <ellipse cx='26' cy='48' rx='12' ry='10' fill='#c2c7d1'/>\n  <ellipse cx='74' cy='48' rx='12' ry='10' fill='#c2c7d1'/>\n\n  <!-- eye mask -->\n  <path d='M18,40 Q30,30 50,36 Q70,30 82,40 Q74,52 50,50 Q26,52 18,40 Z' fill='#5a5f6e'/>\n  <path d='M18,40 Q30,34 50,38 Q70,34 82,40 Q74,46 50,44 Q26,46 18,40 Z' fill='#4a4f5e'/>\n\n  <!-- eyes -->\n  <circle cx='36' cy='41' r='5.5' fill='#1a1c24'/>\n  <circle cx='64' cy='41' r='5.5' fill='#1a1c24'/>\n  <circle cx='34' cy='39' r='2' fill='#ffffff'/>\n  <circle cx='62' cy='39' r='2' fill='#ffffff'/>\n\n  <!-- muzzle -->\n  <ellipse cx='50' cy='55' rx='18' ry='12' fill='#e8ecf2'/>\n\n  <!-- nose -->\n  <ellipse cx='50' cy='50' rx='6' ry='4' fill='#3a3e4a'/>\n  <ellipse cx='50' cy='49' rx='3' ry='1.5' fill='#6a6e7a'/>\n\n  <!-- mouth -->\n  <path d='M50,54 Q46,59 42,57' stroke='#5a5f6e' stroke-width='1.5' fill='none' stroke-linecap='round'/>\n  <path d='M50,54 Q54,59 58,57' stroke='#5a5f6e' stroke-width='1.5' fill='none' stroke-linecap='round'/>\n\n  <!-- scarf -->\n  <path d='M24,68 Q50,78 76,68 L78,74 Q50,84 22,74 Z' fill='#d94a4a'/>\n  <path d='M24,68 Q50,78 76,68 L77,71 Q50,81 23,71 Z' fill='#e86b6b'/>\n  <!-- scarf knot -->\n  <ellipse cx='60' cy='78' rx='7' ry='5' fill='#d94a4a'/>\n  <!-- scarf tail -->\n  <path d='M62,80 Q66,90 62,96 L55,94 Q58,86 56,80 Z' fill='#c93a3a'/>\n  <path d='M62,84 Q65,91 62,95' stroke='#e86b6b' stroke-width='1.5' fill='none'/>\n\n  <!-- body -->\n  <path d='M28,70 Q20,94 50,96 Q80,94 72,