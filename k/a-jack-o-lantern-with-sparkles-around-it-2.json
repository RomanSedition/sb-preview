{"id": "sketch-a-jack-o-lantern-with-sparkles-around-it-2", "title": "Sparkly jack-o'-lantern", "blurb": "", "svg": "<svg viewBox='0 0 100 100' xmlns='http://www.w3.org/2000/svg'>\n  <!-- pumpkin body -->\n  <ellipse cx=\"50\" cy=\"62\" rx=\"30\" ry=\"26\" fill=\"#ff8c00\"/>\n  <!-- pumpkin ridges -->\n  <ellipse cx=\"38\" cy=\"62\" rx=\"14\" ry=\"24\" fill=\"#ffa500\"/>\n  <ellipse cx=\"62\" cy=\"62\" rx=\"14\" ry=\"24\" fill=\"#ffa500\"/>\n  <ellipse cx=\"50\" cy=\"62\" rx=\"10\" ry=\"25\" fill=\"#ffb347\"/>\n  <!-- stem -->\n  <rect x=\"46\" y=\"32\" width=\"8\" height=\"12\" rx=\"3\" fill=\"#4a8c3f\"/>\n  <rect x=\"47\" y=\"32\" width=\"3\" height=\"12\" rx=\"1.5\" fill=\"#6abf5e\"/>\n  <!-- carved face: eyes as triangles -->\n  <polygon points=\"36,56 44,56 40,66\" fill=\"#3a1a00\"/>\n  <polygon points=\"56,56 64,56 60,66\" fill=\"#3a1a00\"/>\n  <!-- carved mouth -->\n  <path d=\"M38,72 L42,68 L46,73 L50,68 L54,73 L58,68 L62,72 L58,78 L42,78 Z\" fill=\"#3a1a00\"/>\n  <!-- inner glow on face -->\n  <polygon points=\"37,57 43,57 40,65\" fill=\"#ffcc00\"/>\n  <polygon points=\"57,57 63,57 60,65\" fill=\"#ffcc00\"/>\n  <!-- sparkles -->\n  <g fill=\"#fff44f\">\n    <polygon points=\"18,30 20,36 26,38 20,40 18,46 16,40 10,38 16,36\"/>\n    <polygon points=\"82,24 84,29 89,31 84,33 82,38 80,33 75,31 80,29\"/>\n    <polygon points=\"75,70 77,75 82,77 77,79 75,84 73,79 68,77 73,75\"/>\n    <polygon points=\"22,72 24,77 29,79 24,81 22,86 20,81 15,79 20,77\"/>\n    <polygon points=\"50,18 52,23 57,25 52,27 50,32 48,27 43,25 48,23\"/>\n    <polygon points=\"60,88 61.5,92 66,93.5 61.5,95 60,99 58.5,95 54,93.5 58.5,92\"/>\n    <polygon points=\"35,88 36.5,92 41,93.5 36.5,95 35,99 33.5,95 29,93.5 33.5,92\"/>\n  </g>\n  <!-- small sparkle dots -->\n  <circle cx=\"28\" cy=\"26\" r=\"2\" fill=\"#ffee88\"/>\n  <circle cx=\"70\" cy=\"34\" r=\"2\" fill=\"#ffee88\"/>\n  <circle cx=\"30\" cy=\"86\" r=\"2\" fill=\"#ffee88\"/>\n  <circle cx=\"72\" cy=\"84\" r=\"2\" fill=\"#ffee88\"/>\