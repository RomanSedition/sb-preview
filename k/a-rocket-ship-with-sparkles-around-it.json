{"id": "sketch-a-rocket-ship-with-sparkles-around-it", "title": "Sparkly rocket ship", "blurb": "", "svg": "<svg viewBox='0 0 100 100' xmlns='http://www.w3.org/2000/svg'>\n  <defs>\n    <linearGradient id='flame' x1='0' y1='0' x2='0' y2='1'>\n      <stop offset='0%' stop-color='#ffcc00'/>\n      <stop offset='50%' stop-color='#ff8800'/>\n      <stop offset='100%' stop-color='#ff3300'/>\n    </linearGradient>\n  </defs>\n  <g transform='rotate(35 50 50)'>\n    <!-- exhaust flame -->\n    <path d='M44 74 Q50 96 56 74 Z' fill='url(#flame)'/>\n    <path d='M47 74 Q50 88 53 74 Z' fill='#fff066'/>\n    <!-- body -->\n    <path d='M50 6 Q64 30 64 58 L62 72 L38 72 L36 58 Q36 30 50 6 Z' fill='#d9e4ee'/>\n    <!-- body shadow side for edge -->\n    <path d='M50 6 Q64 30 64 58 L62 72 L50 72 Z' fill='#b8c8d8'/>\n    <!-- nose cone -->\n    <path d='M50 6 Q58 18 60 26 L40 26 Q42 18 50 6 Z' fill='#ff4d4d'/>\n    <!-- window -->\n    <circle cx='50' cy='40' r='9' fill='#2a4d8f'/>\n    <circle cx='50' cy='40' r='6' fill='#4fc3ff'/>\n    <circle cx='47' cy='37' r='2' fill='#d6f2ff'/>\n    <!-- fins -->\n    <path d='M38 54 L24 76 L24 62 Q30 58 38 54 Z' fill='#ff4d4d'/>\n    <path d='M62 54 L76 76 L76 62 Q70 58 62 54 Z' fill='#e63946'/>\n    <!-- stripes -->\n    <rect x='40' y='60' width='20' height='5' rx='2' fill='#ff4d4d'/>\n  </g>\n  <!-- sparkles -->\n  <g fill='#fff566'>\n    <path d='M20 18 l2 6 6 2 -6 2 -2 6 -2 -6 -6 -2 6 -2 z'/>\n    <path d='M80 30 l1.5 4.5 4.5 1.5 -4.5 1.5 -1.5 4.5 -1.5 -4.5 -4.5 -1.5 4.5 -1.5 z'/>\n    <path d='M76 74 l2 6 6 2 -6 2 -2 6 -2 -6 -6 -2 6 -2 z'/>\n    <path d='M26 80 l1.5 4.5 4.5 1.5 -4.5 1.5 -1.5 4.5 -1.5 -4.5 -4.5 -1.5 4.5 -1.5 z'/>\n  </g>\n  <g fill='#7ff0ff'>\n    <path d='M14 50 l1 3 3 1 -3 1 -1 3 -1 -3 -3 -1 3 -1 z'/>\n    <path d='M88 54 l1 3 3 1 -3 1 -1 3 -1 -3 -3 -1 3 -1 z'/>\n    <circle cx='64' cy='14' r='2'/>\n    <circle cx='36' cy='90' r='2'/>\n  </g>\n</svg>", "tags": ["rocket ship", "sparkles", "sparkly", "sky", "space"]}