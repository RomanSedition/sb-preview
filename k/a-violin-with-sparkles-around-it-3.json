{"id": "sketch-a-violin-with-sparkles-around-it-3", "title": "Sparkly violin", "blurb": "", "svg": "<svg viewBox='0 0 100 100' xmlns='http://www.w3.org/2000/svg'>\n  <!-- Sparkles -->\n  <g fill='#FFE66D'>\n    <polygon points='15,20 17,26 23,28 17,30 15,36 13,30 7,28 13,26'/>\n    <polygon points='82,15 84,21 90,23 84,25 82,31 80,25 74,23 80,21'/>\n    <polygon points='88,55 89.5,60 94,61 89.5,62 88,67 86.5,62 82,61 86.5,60'/>\n    <polygon points='12,65 13.5,70 18,71 13.5,72 12,77 10.5,72 6,71 10.5,70'/>\n    <polygon points='70,5 71.5,9 75,10 71.5,11 70,15 68.5,11 65,10 68.5,9'/>\n    <polygon points='25,85 26.5,89 30,90 26.5,91 25,95 23.5,91 20,90 23.5,89'/>\n    <polygon points='90,85 91,88 94,89 91,90 90,93 89,90 86,89 89,88'/>\n  </g>\n\n  <!-- Violin body -->\n  <g>\n    <!-- Main body -->\n    <ellipse cx='48' cy='65' rx='16' ry='20' fill='#C0682F'/>\n    <!-- Upper bout -->\n    <ellipse cx='48' cy='47' rx='12' ry='12' fill='#D4782F'/>\n    <!-- Lower bout wider -->\n    <ellipse cx='48' cy='78' rx='15' ry='12' fill='#D4782F'/>\n    <!-- Waist indent left -->\n    <ellipse cx='35' cy='60' rx='5' ry='8' fill='#A85820'/>\n    <!-- Waist indent right -->\n    <ellipse cx='61' cy='60' rx='5' ry='8' fill='#A85820'/>\n    <!-- Body highlight -->\n    <ellipse cx='44' cy='60' rx='6' ry='14' fill='#E08840' opacity='0.5'/>\n  </g>\n\n  <!-- F-holes -->\n  <g fill='#3A1A08'>\n    <path d='M40,57 Q38,60 40,63 Q42,60 40,57 Z'/>\n    <path d='M56,57 Q58,60 56,63 Q54,60 56,57 Z'/>\n  </g>\n\n  <!-- Bridge -->\n  <rect x='42' y='64' width='12' height='3' rx='1' fill='#F5D78E'/>\n\n  <!-- Fingerboard / neck -->\n  <rect x='45' y='18' width='6' height='30' rx='1' fill='#3D2B1F'/>\n  <!-- Neck highlight -->\n  <rect x='45.5' y='18' width='2' height='30' rx='1' fill='#5A3F2D'/>\n\n  <!-- Strings -->\n  <g stroke='#F5D78E' stroke-width='0.8'>\n    <line x1='46' y1='20' x2='46' y2='75'/>\n    <line x1='47.3' y1='20' x2='47.3' y2='75'/>\n    <line x1='48.7' y1='20' x2='48.7' y2='75'/>\n    <line x1='50' y1='20' x2='50' y2='75'/>\n  </g>\n\n  <!-- Scroll / pegbox -->\n  <g>\n    <rect x='45' y='12' width='6' height='8' rx='2' fill='#C0682F'/>\n    <!-- Scroll curl -->\n    <circle cx='48' cy='11' r='4' fill='#D4782F'/>\n    <circle cx='48' cy='10' r='2' fill='#A85820'/>\n    <!-- Pegs -->\n    <rect x='42' y='13' width='4' height='2' rx='1' fill='#5A3F2D'/>\n    <rect x='51' y='13' width='4' height='2' rx='1' fill='#5A3F2D'/>\n    <rect x='42' y='16' width='4' height='2' rx='1' fill='#5A3F2D'/>\n    <rect x='51' y='16' width='4' height='2' rx='1' fill='#5A3F2D'/>\n  </g>\n\n  <!-- Chinrest -->\n  <ellipse cx='54' cy='76' rx='5' ry='4' fill='#2A1A10'/>\n\n  <!-- Tailpiece -->\n  <path d='M46,72 L50,72 L49,82 L47,82 Z' fill='#3D2B1F'/>\n\n  <!-- Bow -->\n  <g>\n    <line x1='30' y1='88' x2='65' y2='30' stroke='#8B5E3C' stroke-width='2'/>\n    <line x1='32' y1='86' x2='63' y2='32' stroke='#F5D78E' stroke-width='0.8'/>\n    <!-- Bow tip -->\n    <polygon points='65,30 67,27 63,32' fill='#8B5E3C'/>\n    <!-- Bow frog -->\n    <rect x='29' y='86' width='4' height='3' rx='1' fill='#2A1A10' transform='rotate(-28 31 87)'/>\n  </g>\n</svg>", "tags": ["violin", "sparkles", "sparkly", "music"]}