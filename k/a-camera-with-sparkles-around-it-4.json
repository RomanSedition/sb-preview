{"id": "sketch-a-camera-with-sparkles-around-it-4", "title": "Sparkly camera", "blurb": "", "svg": "<svg viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\">\n  <!-- sparkles -->\n  <g fill=\"#FFE45C\">\n    <polygon points=\"12,20 14,26 20,28 14,30 12,36 10,30 4,28 10,26\"/>\n    <polygon points=\"88,15 90,20 95,22 90,24 88,29 86,24 81,22 86,20\"/>\n    <polygon points=\"85,70 87,74 91,76 87,78 85,82 83,78 79,76 83,74\"/>\n    <polygon points=\"10,72 12,75 15,76 12,77 10,80 8,77 5,76 8,75\"/>\n    <polygon points=\"50,8 52,12 56,13 52,14 50,18 48,14 44,13 48,12\"/>\n    <polygon points=\"92,45 94,48 97,49 94,50 92,53 90,50 87,49 90,48\"/>\n  </g>\n  <!-- camera body -->\n  <rect x=\"22\" y=\"36\" width=\"56\" height=\"38\" rx=\"6\" ry=\"6\" fill=\"#4A90D9\"/>\n  <!-- camera top bump -->\n  <rect x=\"38\" y=\"28\" width=\"24\" height=\"12\" rx=\"4\" ry=\"4\" fill=\"#3A7BC8\"/>\n  <!-- lens outer ring -->\n  <circle cx=\"50\" cy=\"55\" r=\"16\" fill=\"#2C3E50\"/>\n  <!-- lens mid ring -->\n  <circle cx=\"50\" cy=\"55\" r=\"12\" fill=\"#5DADE2\"/>\n  <!-- lens inner -->\n  <circle cx=\"50\" cy=\"55\" r=\"7\" fill=\"#1A252F\"/>\n  <!-- lens shine -->\n  <circle cx=\"46\" cy=\"51\" r=\"3\" fill=\"#85C1E9\"/>\n  <!-- viewfinder -->\n  <rect x=\"27\" y=\"40\" width=\"6\" height=\"4\" rx=\"1\" fill=\"#FFE45C\"/>\n  <!-- flash -->\n  <rect x=\"68\" y=\"40\" width=\"8\" height=\"6\" rx=\"1\" fill=\"#FFE45C\"/>\n  <!-- shutter button -->\n  <rect x=\"44\" y=\"30\" width=\"12\" height=\"5\" rx=\"2\" fill=\"#FF6B6B\"/>\n  <!-- sparkle near lens -->\n  <polygon points=\"70,30 71,33 74,34 71,35 70,38 69,35 66,34 69,33\" fill=\"#FFFFFF\" opacity=\"0.85\"/>\n</svg>", "tags": ["camera", "sparkles", "sparkly", "tech"]}