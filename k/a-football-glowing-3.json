{"id": "sketch-a-football-glowing-3", "title": "Glowing football", "blurb": "", "svg": "<svg viewBox='0 0 100 100' xmlns='http://www.w3.org/2000/svg'>\n  <!-- glow halo -->\n  <circle cx='50' cy='52' r='46' fill='#2a6b3a' opacity='0.25'/>\n  <circle cx='50' cy='52' r='40' fill='#3a8a4a' opacity='0.3'/>\n  <!-- football body -->\n  <circle cx='50' cy='52' r='32' fill='#f2f2f2'/>\n  <!-- shading for sphere feel -->\n  <circle cx='60' cy='64' r='26' fill='#d6d6d6' opacity='0.55'/>\n  <circle cx='42' cy='40' r='14' fill='#ffffff' opacity='0.6'/>\n  <!-- pentagons: center one dark slate-blue (lit) -->\n  <polygon points='50,38 58,44 55,53 45,53 42,44' fill='#3a2f6b'/>\n  <!-- surrounding pentagons -->\n  <polygon points='50,20 57,26 54,34 46,34 43,26' fill='#4a3f80'/>\n  <polygon points='78,46 80,55 72,59 66,52 70,45' fill='#4a3f80'/>\n  <polygon points='22,46 30,45 34,52 28,59 20,55' fill='#4a3f80'/>\n  <polygon points='44,72 52,68 58,73 55,81 47,81 43,78' fill='#4a3f80'/>\n  <polygon points='72,72 76,79 69,84 62,79 64,71' fill='#4a3f80'/>\n  <polygon points='28,72 36,71 38,79 31,84 24,79' fill='#4a3f80'/>\n  <!-- seams connecting -->\n  <g stroke='#b8b8b8' stroke-width='1.6' fill='none'>\n    <line x1='50' y1='20' x2='46' y2='34'/>\n    <line x1='57' y1='26' x2='58' y2='44'/>\n    <line x1='80' y1='55' x2='55' y2='53'/>\n    <line x1='20' y1='55' x2='42' y2='44'/>\n    <line x1='43' y1='26' x2='30' y2='45'/>\n    <line x1='70' y1='45' x2='54' y2='34'/>\n    <line x1='45' y1='53' x2='47' y2='81'/>\n    <line x1='55' y1='53' x2='62' y2='79'/>\n    <line x1='45' y1='53' x2='38' y2='79'/>\n    <line x1='31' y1='84' x2='22' y2='55'/>\n    <line x1='69' y1='84' x2='80' y2='55'/>\n    <line x1='47' y1='81' x2='31' y2='84'/>\n    <line x1='47' y1='81' x2='69' y2='84'/>\n  </g>\n  <!-- bright shine -->\n  <ellipse cx='40' cy='36' rx='7' ry='5' fill='#ffffff' opacity='0.8'/>\n  <circle cx='36' cy='34' r='2.5' fill='#ffffff'/>\n  <!-- glow rim -->\n  <circle cx='50' cy='52' r='32