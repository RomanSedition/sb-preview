{"id": "sketch-a-popsicle-with-sparkles-around-it-3", "title": "Sparkly popsicle", "blurb": "", "svg": "<svg viewBox='0 0 100 100' xmlns='http://www.w3.org/2000/svg'>\n  <!-- popsicle stick -->\n  <rect x='44' y='68' width='12' height='26' rx='4' fill='#e8b980'/>\n  <rect x='44' y='68' width='5' height='26' rx='2' fill='#f6d3a3'/>\n  <!-- popsicle body: orange top, pink bottom -->\n  <rect x='26' y='10' width='48' height='62' rx='14' fill='#ff9a3c'/>\n  <path d='M26 42 h48 v16 a14 14 0 0 1 -14 14 h-20 a14 14 0 0 1 -14 -14 z' fill='#ff5f8f'/>\n  <!-- lighter highlight on left of orange -->\n  <path d='M34 22 a12 12 0 0 1 10 -8 v50 h-10 z' fill='#ffc07a' opacity='0.9'/>\n  <!-- lighter pink highlight -->\n  <path d='M34 46 h8 v22 h-8 z' fill='#ff9fb8' opacity='0.9'/>\n  <!-- drip line between colors -->\n  <path d='M28 44 q6 6 12 0 q6 6 12 0 q6 6 12 0 q6 6 12 0' fill='none' stroke='#ffe0b0' stroke-width='2.5' stroke-linecap='round'/>\n  <!-- white sparkles -->\n  <g fill='#ffffff'>\n    <path d='M14 18 l2 5 5 2 -5 2 -2 5 -2 -5 -5 -2 5 -2 z'/>\n    <path d='M86 30 l2 5 5 2 -5 2 -2 5 -2 -5 -5 -2 5 -2 z'/>\n    <path d='M82 62 l1.6 4 4 1.6 -4 1.6 -1.6 4 -1.6 -4 -4 -1.6 4 -1.6 z'/>\n    <path d='M16 60 l1.6 4 4 1.6 -4 1.6 -1.6 4 -1.6 -4 -4 -1.6 4 -1.6 z'/>\n  </g>\n  <!-- pale yellow sparkles -->\n  <g fill='#fff3a8'>\n    <path d='M22 36 l1.4 3.6 3.6 1.4 -3.6 1.4 -1.4 3.6 -1.4 -3.6 -3.6 -1.4 3.6 -1.4 z'/>\n    <path d='M78 14 l1.4 3.6 3.6 1.4 -3.6 1.4 -1.4 3.6 -1.4 -3.6 -3.6 -1.4 3.6 -1.4 z'/>\n    <path d='M74 80 l1.4 3.6 3.6 1.4 -3.6 1.4 -1.4 3.6 -1.4 -3.6 -3.6 -1.4 3.6 -1.4 z'/>\n    <path d='M20 78 l1.4 3.6 3.6 1.4 -3.6 1.4 -1.4 3.6 -1.4 -3.6 -3.6 -1.4 3.6 -1.4 z'/>\n  </g>\n</svg>", "tags": ["popsicle", "sparkles", "sparkly", "food"]}