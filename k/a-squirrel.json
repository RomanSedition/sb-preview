{"id": "sketch-a-squirrel", "title": "Squirrel", "blurb": "", "svg": "<svg viewBox='0 0 100 100' xmlns='http://www.w3.org/2000/svg'>\n  <g>\n    <!-- tail -->\n    <path d='M62,70 C82,72 92,55 88,38 C84,22 72,16 64,22 C56,28 58,40 66,44 C74,48 78,42 76,36 C74,52 68,62 58,66 Z' fill='#e07a3a'/>\n    <path d='M70,44 C78,42 80,34 76,28 C73,24 66,26 66,32 C66,37 69,40 72,40 Z' fill='#f6a15a'/>\n    <!-- body -->\n    <ellipse cx='50' cy='66' rx='24' ry='22' fill='#d96a2c'/>\n    <!-- belly -->\n    <ellipse cx='50' cy='72' rx='14' ry='15' fill='#fbe0b8'/>\n    <!-- back legs -->\n    <ellipse cx='34' cy='86' rx='10' ry='6' fill='#b9541f'/>\n    <ellipse cx='64' cy='86' rx='10' ry='6' fill='#b9541f'/>\n    <!-- front legs -->\n    <rect x='40' y='76' width='7' height='12' rx='3' fill='#c95a24'/>\n    <rect x='53' y='76' width='7' height='12' rx='3' fill='#c95a24'/>\n    <!-- head -->\n    <circle cx='50' cy='38' r='17' fill='#d96a2c'/>\n    <!-- ears -->\n    <path d='M38,26 C34,14 40,10 44,20 Z' fill='#e07a3a'/>\n    <path d='M62,26 C66,14 60,10 56,20 Z' fill='#e07a3a'/>\n    <path d='M39,24 C37,18 40,16 42,21 Z' fill='#fbe0b8'/>\n    <path d='M61,24 C63,18 60,16 58,21 Z' fill='#fbe0b8'/>\n    <!-- cheeks -->\n    <circle cx='41' cy='43' r='6' fill='#fbe0b8'/>\n    <circle cx='59' cy='43' r='6' fill='#fbe0b8'/>\n    <!-- muzzle -->\n    <ellipse cx='50' cy='46' rx='7' ry='5' fill='#fff3dc'/>\n    <circle cx='50' cy='42' r='2.5' fill='#7a3a12'/>\n    <!-- eyes -->\n    <circle cx='43' cy='35' r='3.5' fill='#3a1a08'/>\n    <circle cx='57' cy='35' r='3.5' fill='#3a1a08'/>\n    <circle cx='44' cy='34' r='1.2' fill='#ffffff'/>\n    <circle cx='58' cy='34' r='1.2' fill='#ffffff'/>\n    <!-- teeth -->\n    <rect x='48' y='49' width='4' height='4' rx='1' fill='#fff3dc'/>\n    <!-- acorn -->\n    <ellipse cx='76' cy='78' rx='6' ry='7' fill='#c98a3a'/>\n    <path d='M69,74 C70,70 82,70 83,74 Z' fill='#8b5a24'/>\n    <rect x='74.5' y='67' width='3' height='4' rx='1.5' fill='#8b5a2