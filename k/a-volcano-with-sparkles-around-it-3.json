{"id": "sketch-a-volcano-with-sparkles-around-it-3", "title": "Sparkly volcano", "blurb": "", "svg": "<svg viewBox='0 0 100 100' xmlns='http://www.w3.org/2000/svg'>\n  <defs>\n    <radialGradient id='glowG' cx='50%' cy='55%' r='50%'>\n      <stop offset='0%' stop-color='#ffdd44'/>\n      <stop offset='100%' stop-color='#ff6600'/>\n    </radialGradient>\n  </defs>\n  <!-- ground shadow -->\n  <ellipse cx='50' cy='82' rx='38' ry='10' fill='#553322'/>\n  <!-- volcano body -->\n  <polygon points='18,82 50,30 82,82' fill='#884422'/>\n  <!-- lighter left face -->\n  <polygon points='18,82 50,30 50,82' fill='#aa6633'/>\n  <!-- crater rim -->\n  <ellipse cx='50' cy='32' rx='12' ry='5' fill='#cc8844'/>\n  <!-- crater inner -->\n  <ellipse cx='50' cy='32' rx='9' ry='3.5' fill='#ffaa22'/>\n  <!-- lava drip center -->\n  <path d='M46,34 Q48,42 47,48 Q50,44 52,40 Q54,44 53,50 Q56,40 54,34 Z' fill='#ffcc33'/>\n  <!-- lava drips sides -->\n  <path d='M42,34 Q40,44 41,52 Q44,48 44,42 Q46,38 46,34 Z' fill='#ffaa22'/>\n  <path d='M58,34 Q60,46 59,54 Q56,48 56,42 Q54,38 54,34 Z' fill='#ffaa22'/>\n  <!-- erupting lava top -->\n  <path d='M44,30 Q47,20 50,24 Q53,16 56,28 Q54,24 52,28 Q50,22 48,28 Q46,24 44,30 Z' fill='#ff8833'/>\n  <!-- lava glow at crater -->\n  <ellipse cx='50' cy='32' rx='7' ry='2.5' fill='#ffee55'/>\n  <!-- rock texture patches -->\n  <polygon points='30,70 36,62 40,70 34,76' fill='#995533'/>\n  <polygon points='62,66 68,58 72,68 66,74' fill='#995533'/>\n  <polygon points='44,58 48,52 52,58 48,62' fill='#995533'/>\n  <!-- sparkles around volcano -->\n  <g fill='#ffee77'>\n    <polygon points='14,48 16,52 20,54 16,56 14,60 12,56 8,54 12,52'/>\n    <polygon points='86,44 88,48 92,50 88,52 86,56 84,52 80,50 84,48'/>\n    <polygon points='22,28 23.5,31 27,32 23.5,33 22,36 20.5,33 17,32 20.5,31'/>\n    <polygon points='78,24 79.5,27 83,28 79.5,29 78,32 76.5,29 73,28 76.5,27'/>\n    <polygon points='50,12 51.5,15 55,16 51.5,17 50,20 48.5,17 45,16 48.5,15'/>\n  </g>\n  <!-- small sparkle dots -->\n  <circle cx='10' cy='36' r='1.8' fill='#ffdd66'/>\n  <circle cx='90' cy='34' r='1.8' fill='#ffdd66'/>\n  <circle cx='34' cy='16' r='1.5' fill='#ffdd66'/>\n  <circle cx='66' cy='14' r='1.5' fill='#ffdd66'/>\n  <circle cx='90' cy='62' r='1.5' fill='#ffdd66'/>\n  <circle cx='8' cy='64' r='1.5' fill='#ffdd66'/>\n</svg>", "tags": ["volcano", "sparkles", "sparkly", "nature"]}