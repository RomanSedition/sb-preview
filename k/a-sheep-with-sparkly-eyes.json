{"id": "sketch-a-sheep-with-sparkly-eyes", "title": "Sheep with sparkly eyes", "blurb": "", "svg": "<svg viewBox='0 0 100 100' xmlns='http://www.w3.org/2000/svg'>\n  <!-- fluffy wool body -->\n  <circle cx=\"50\" cy=\"52\" r=\"26\" fill=\"#f2f0e6\"/>\n  <circle cx=\"32\" cy=\"42\" r=\"13\" fill=\"#f7f5ec\"/>\n  <circle cx=\"50\" cy=\"34\" r=\"14\" fill=\"#fbf9f2\"/>\n  <circle cx=\"68\" cy=\"42\" r=\"13\" fill=\"#f7f5ec\"/>\n  <circle cx=\"28\" cy=\"58\" r=\"12\" fill=\"#ece9dc\"/>\n  <circle cx=\"72\" cy=\"58\" r=\"12\" fill=\"#ece9dc\"/>\n  <circle cx=\"38\" cy=\"68\" r=\"12\" fill=\"#f2f0e6\"/>\n  <circle cx=\"62\" cy=\"68\" r=\"12\" fill=\"#f2f0e6\"/>\n  <circle cx=\"50\" cy=\"70\" r=\"12\" fill=\"#faf8f0\"/>\n  <!-- legs -->\n  <rect x=\"38\" y=\"72\" width=\"8\" height=\"16\" rx=\"4\" fill=\"#4b4b5e\"/>\n  <rect x=\"54\" y=\"72\" width=\"8\" height=\"16\" rx=\"4\" fill=\"#4b4b5e\"/>\n  <!-- hooves -->\n  <rect x=\"37\" y=\"84\" width=\"10\" height=\"6\" rx=\"3\" fill=\"#2f2f42\"/>\n  <rect x=\"53\" y=\"84\" width=\"10\" height=\"6\" rx=\"3\" fill=\"#2f2f42\"/>\n  <!-- face -->\n  <circle cx=\"50\" cy=\"46\" r=\"18\" fill=\"#e8d9c0\"/>\n  <!-- ears -->\n  <ellipse cx=\"30\" cy=\"42\" rx=\"7\" ry=\"4\" fill=\"#e8d9c0\" transform=\"rotate(-20 30 42)\"/>\n  <ellipse cx=\"70\" cy=\"42\" rx=\"7\" ry=\"4\" fill=\"#e8d9c0\" transform=\"rotate(20 70 42)\"/>\n  <!-- hair tuft -->\n  <circle cx=\"44\" cy=\"30\" r=\"6\" fill=\"#fbf9f2\"/>\n  <circle cx=\"50\" cy=\"28\" r=\"6\" fill=\"#f2f0e6\"/>\n  <circle cx=\"56\" cy=\"30\" r=\"6\" fill=\"#fbf9f2\"/>\n  <!-- sparkly eyes -->\n  <circle cx=\"42\" cy=\"45\" r=\"5\" fill=\"#3b2f4a\"/>\n  <circle cx=\"58\" cy=\"45\" r=\"5\" fill=\"#3b2f4a\"/>\n  <circle cx=\"43.5\" cy=\"43.5\" r=\"2.5\" fill=\"#ffffff\"/>\n  <circle cx=\"59.5\" cy=\"43.5\" r=\"2.5\" fill=\"#ffffff\"/>\n  <circle cx=\"41\" cy=\"46.8\" r=\"1.2\" fill=\"#ffe680\"/>\n  <circle cx=\"57\" cy=\"46.8\" r=\"1.2\" fill=\"#ffe680\"/>\n  <circle cx=\"44.5\" cy=\"47\" r=\"0.8\" fill=\"#b0e0ff\"/>\n  <circle cx=\"60.5\" cy=\"47\" r=\"0.8\" fill=\"#b0e0ff\"/>\n  <!-- nose -->\n  <ellipse cx=\"50\" cy=\"53\" rx=\"3\" ry=\"2\" fill=\"#c58a6a\"/>\n  <!-- mouth -->\n  <path d=\"M46 56 Q50 59 54 56\" stroke=\"#b5765a\" stroke-width=\"1.2\" fill=\"none\" stroke-linecap=\"round\"/>\n  <!-- rosy cheeks -->\n  <circle cx=\"36\" cy=\"52\" r=\"3\" fill=\"#f4a6a6\" opacity=\"0.7\"/>\n  <circle cx=\"64\" cy=\"52\" r=\"3\" fill=\"#f4a6a6\" opacity=\"0.7\"/>\n  <!-- sparkles around -->\n  <g fill=\"#ffe680\">\n    <path d=\"M20 28 l1.5 3.5 3.5 1.5 -3.5 1.5 -1.5 3.5 -1.5 -3.5 -3.5 -1.5 3.5 -1.5z\"/>\n    <path d=\"M80 24 l1.2 2.8 2.8 1.2 -2.8 1.2 -1.2 2.8 -1.2 -2.8 -2.8 -1.2 2.8 -1.2z\"/>\n    <path d=\"M78 68 l1 2.3 2.3 1 -2.3 1 -1 2.3 -1 -2.3 -2.3 -1 2.3 -1z\"/>\n    <path d=\"M22 70 l1 2.3 2.3 1 -2.3 1 -1 2.3 -1 -2.3 -2.3 -1 2.3 -1z\"/>\n  </g>\n  <g fill=\"#b0e0ff\">\n    <path d=\"M14 50 l0.8 1.8 1.8 0.8 -1.8 0.8 -0.8 1.8 -0.8 -1.8 -1.8 -0.8 1.8 -0.8z\"/>\n    <path d=\"M86 54 l0.8 1.8 1.8 0.8 -1.8 0.8 -0.8 1.8 -0.8 -1.8 -1.8 -0.8 1.8 -0.8z\"/>\n  </g>\n</svg>", "tags": ["sheep", "sparkly eyes", "farm", "animal"]}