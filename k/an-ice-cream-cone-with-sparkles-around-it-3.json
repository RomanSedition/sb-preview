{"id": "sketch-an-ice-cream-cone-with-sparkles-around-it-3", "title": "Sparkly ice cream cone", "blurb": "", "svg": "<svg viewBox=\"0 0 100 100\" xmlns='http://www.w3.org/2000/svg'>\n  <!-- Sparkles -->\n  <g fill=\"#FFE66D\">\n    <polygon points=\"15,20 17,26 23,28 17,30 15,36 13,30 7,28 13,26\"/>\n    <polygon points=\"85,15 86.5,20 91,21.5 86.5,23 85,28 83.5,23 79,21.5 83.5,20\"/>\n    <polygon points=\"80,45 81.5,50 86,51.5 81.5,53 80,58 78.5,53 74,51.5 78.5,50\"/>\n    <polygon points=\"20,55 21.5,60 26,61.5 21.5,63 20,68 18.5,63 14,61.5 18.5,60\"/>\n    <polygon points=\"12,75 13,79 17,80 13,81 12,85 11,81 7,80 11,79\"/>\n    <polygon points=\"88,72 89,76 93,77 89,78 88,82 87,78 83,77 87,76\"/>\n  </g>\n  \n  <!-- Cone (waffle) -->\n  <polygon points=\"35,48 65,48 50,90\" fill=\"#D69E4F\"/>\n  <!-- Cone waffle lines -->\n  <g stroke=\"#B87D2E\" stroke-width=\"1.5\" stroke-linecap=\"round\">\n    <line x1=\"38\" y1=\"54\" x2=\"62\" y2=\"54\"/>\n    <line x1=\"40\" y1=\"60\" x2=\"60\" y2=\"60\"/>\n    <line x1=\"42\" y1=\"66\" x2=\"58\" y2=\"66\"/>\n    <line x1=\"44\" y1=\"72\" x2=\"56\" y2=\"72\"/>\n    <line x1=\"46\" y1=\"78\" x2=\"54\" y2=\"78\"/>\n    <line x1=\"43\" y1=\"51\" x2=\"47\" y2=\"57\"/>\n    <line x1=\"50\" y1=\"51\" x2=\"50\" y2=\"57\"/>\n    <line x1=\"57\" y1=\"51\" x2=\"53\" y2=\"57\"/>\n    <line x1=\"46\" y1=\"63\" x2=\"48\" y2=\"69\"/>\n    <line x1=\"54\" y1=\"63\" x2=\"52\" y2=\"69\"/>\n  </g>\n  \n  <!-- Ice cream scoop bottom -->\n  <ellipse cx=\"50\" cy=\"46\" rx=\"20\" ry=\"14\" fill=\"#FFB6C1\"/>\n  <!-- Ice cream scoop top -->\n  <ellipse cx=\"50\" cy=\"34\" rx=\"16\" ry=\"12\" fill=\"#FF8FAB\"/>\n  <!-- Drip details -->\n  <circle cx=\"34\" cy=\"48\" r=\"3\" fill=\"#FFB6C1\"/>\n  <circle cx=\"66\" cy=\"47\" r=\"2.5\" fill=\"#FFB6C1\"/>\n  \n  <!-- Cherry on top -->\n  <circle cx=\"50\" cy=\"22\" r=\"6\" fill=\"#E63946\"/>\n  <circle cx=\"48\" cy=\"20\" r=\"2\" fill=\"#FF6B6B\"/>\n  <!-- Cherry stem -->\n  <path d=\"M 50,16 Q 52,10 55,8\" stroke=\"#4CAF50\" stroke-width=\"1.8\" fill=\"none\" stroke-linecap=\"round\"/>\n  \n  <!-- Extra sparkle on ice cream -->\n  <polygon points=\"35,30 36,33 39,34 36,35 35,38 34,35 31,34 34,33\" fill=\"#FFFFFF\"/>\n</svg>", "tags": ["ice cream cone", "sparkles", "sparkly", "food"]}