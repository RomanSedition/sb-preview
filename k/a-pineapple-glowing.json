{"id": "sketch-a-pineapple-glowing", "title": "Glowing pineapple", "blurb": "", "svg": "<svg viewBox=\"0 0 100 100\" xmlns='http://www.w3.org/2000/svg'>\n  <!-- Pineapple body -->\n  <ellipse cx=\"50\" cy=\"58\" rx=\"26\" ry=\"34\" fill=\"#FFB300\" stroke=\"#FFD54F\" stroke-width=\"2\"/>\n  \n  <!-- Diamond crosshatch pattern -->\n  <g fill=\"none\" stroke=\"#FF8F00\" stroke-width=\"1.8\">\n    <!-- Diagonal lines one way -->\n    <line x1=\"34\" y1=\"32\" x2=\"50\" y2=\"48\"/>\n    <line x1=\"42\" y1=\"28\" x2=\"56\" y2=\"42\"/>\n    <line x1=\"50\" y1=\"26\" x2=\"64\" y2=\"40\"/>\n    <line x1=\"58\" y1=\"28\" x2=\"72\" y2=\"42\"/>\n    <line x1=\"66\" y1=\"32\" x2=\"76\" y2=\"42\"/>\n    <line x1=\"28\" y1=\"38\" x2=\"44\" y2=\"54\"/>\n    <line x1=\"26\" y1=\"46\" x2=\"40\" y2=\"60\"/>\n    <line x1=\"24\" y1=\"54\" x2=\"38\" y2=\"68\"/>\n    <line x1=\"24\" y1=\"62\" x2=\"38\" y2=\"76\"/>\n    <line x1=\"26\" y1=\"70\" x2=\"42\" y2=\"86\"/>\n    <line x1=\"30\" y1=\"78\" x2=\"46\" y2=\"94\"/>\n    <line x1=\"38\" y1=\"84\" x2=\"50\" y2=\"96\"/>\n    <line x1=\"56\" y1=\"48\" x2=\"72\" y2=\"64\"/>\n    <line x1=\"58\" y1=\"56\" x2=\"74\" y2=\"72\"/>\n    <line x1=\"58\" y1=\"64\" x2=\"74\" y2=\"80\"/>\n    <line x1=\"56\" y1=\"72\" x2=\"70\" y2=\"86\"/>\n    <line x1=\"50\" y1=\"80\" x2=\"64\" y2=\"94\"/>\n    <!-- Diagonal lines other way -->\n    <line x1=\"66\" y1=\"30\" x2=\"50\" y2=\"46\"/>\n    <line x1=\"58\" y1=\"28\" x2=\"44\" y2=\"42\"/>\n    <line x1=\"50\" y1=\"26\" x2=\"36\" y2=\"40\"/>\n    <line x1=\"42\" y1=\"28\" x2=\"28\" y2=\"42\"/>\n    <line x1=\"34\" y1=\"32\" x2=\"24\" y2=\"42\"/>\n    <line x1=\"72\" y1=\"36\" x2=\"56\" y2=\"52\"/>\n    <line x1=\"74\" y1=\"44\" x2=\"60\" y2=\"58\"/>\n    <line x1=\"76\" y1=\"52\" x2=\"62\" y2=\"66\"/>\n    <line x1=\"76\" y1=\"60\" x2=\"62\" y2=\"74\"/>\n    <line x1=\"74\" y1=\"68\" x2=\"58\" y2=\"84\"/>\n    <line x1=\"70\" y1=\"76\" x2=\"54\" y2=\"92\"/>\n    <line x1=\"62\" y1=\"82\" x2=\"50\" y2=\"94\"/>\n    <line x1=\"44\" y1=\"48\" x2=\"28\" y2=\"64\"/>\n    <line x1=\"42\" y1=\"56\" x2=\"26\" y2=\"72\"/>\n    <line x1=\"42\" y1=\"64\" x2=\"26\" y2=\"80\"/>\n    <line x1=\"44\" y1=\"72\" x2=\"30\" y2=\"86\"/>\n    <line x1=\"50\" y1=\"80\" x2=\"36\" y2=\"94\"/>\n  </g>\n  \n  <!-- Glow dots in pattern centers -->\n  <g fill=\"#FFE082\">\n    <circle cx=\"42\" cy=\"40\" r=\"2.5\"/>\n    <circle cx=\"58\" cy=\"40\" r=\"2.5\"/>\n    <circle cx=\"34\" cy=\"50\" r=\"2.5\"/>\n    <circle cx=\"50\" cy=\"50\" r=\"2.5\"/>\n    <circle cx=\"66\" cy=\"50\" r=\"2.5\"/>\n    <circle cx=\"42\" cy=\"60\" r=\"2.5\"/>\n    <circle cx=\"58\" cy=\"60\" r=\"2.5\"/>\n    <circle cx=\"34\" cy=\"70\" r=\"2.5\"/>\n    <circle cx=\"50\" cy=\"70\" r=\"2.5\"/>\n    <circle cx=\"66\" cy=\"70\" r=\"2.5\"/>\n    <circle cx=\"42\" cy=\"80\" r=\"2.5\"/>\n    <circle cx=\"58\" cy=\"80\" r=\"2.5\"/>\n  </g>\n\n  <!-- Crown leaves -->\n  <g fill=\"#4CAF50\" stroke=\"#66BB6A\" stroke-width=\"1.5\">\n    <path d=\"M50 26 Q48 10 44 4 Q50 8 52 18 Z\"/>\n    <path d=\"M50 26 Q54 8 58 2 Q54 10 52 20 Z\"/>\n    <path d=\"M48 26 Q42 10 36 6 Q44 14 46 24 Z\"/>\n    <path d=\"M52 26 Q60 10 68 8 Q58 14 54 24 Z\"/>\n    <path d=\"M46 28 Q38 16 30 14 Q40 18 44 26 Z\"/>\n    <path d=\"M54 28 Q64 16 72 16 Q60 18 56 26 Z\"/>\n  </g>\n  \n  <!-- Leaf highlights -->\n  <g fill=\"#81C784\">\n    <path d=\"M50 24 Q49 12 46 7 Q50 12 51 22 Z\"/>\n    <path d=\"M50 24 Q53 10 56 5 Q53 12 51 22 Z\"/>\n  </g>\n\n  <!-- Cute face -->\n  <g fill=\"#3E2723\">\n    <!-- Eyes -->\n    <ellipse cx=\"40\" cy=\"52\" rx=\"4\" ry=\"4.5\"/>\n    <ellipse cx=\"60\" cy=\"52\" rx=\"4\" ry=\"4.5\"/>\n  </g>\n  <!-- Eye highlights -->\n  <g fill=\"#FFFFFF\">\n    <circle cx=\"38.5\" cy=\"50.5\" r=\"1.5\"/>\n    <circle cx=\"58.5\" cy=\"50.5\" r=\"1.5\"/>\n  </g>\n  <!-- Blush -->\n  <g fill=\"#FF8A65\" opacity=\"0.7\">\n    <ellipse cx=\"32\" cy=\"60\" rx=\"4\" ry=\"2.5\"/>\n    <ellipse cx=\"68\" cy=\"60\" rx=\"4\" ry=\"2.5\"/>\n  </g>\n  <!-- Smile -->\n  <path d=\"M44 64 Q50 70 56 64\" fill=\"none\" stroke=\"#3E2723\" stroke-width=\"2\" stroke-linecap=\"round\"/>\n  \n  <!-- Glow aura around pineapple -->\n  <ellipse cx=\"50\" cy=\"58\" rx=\"30\" ry=\"38\" fill=\"none\" stroke=\"#FFE082\" stroke-width=\"1\" opacity=\"0.4\"/>\n  <ellipse cx=\"50\" cy=\"58\" rx=\"33\" ry=\"41\" fill=\"none\" stroke=\"#FFE082\" stroke-width=\"0.6\" opacity=\"0.2\"/>\n</svg>", "tags": ["pineapple", "glowing", "food", "fruit"]}