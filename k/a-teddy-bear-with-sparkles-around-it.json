{"id": "sketch-a-teddy-bear-with-sparkles-around-it", "title": "Sparkly teddy bear", "blurb": "", "svg": "<svg viewBox='0 0 100 100' xmlns='http://www.w3.org/2000/svg'>\n  <!-- sparkles -->\n  <g fill='#FFE066'>\n    <path d='M12 18 l2 4 4 2 -4 2 -2 4 -2 -4 -4 -2 4 -2z'/>\n    <path d='M85 15 l1.5 3 3 1.5 -3 1.5 -1.5 3 -1.5 -3 -3 -1.5 3 -1.5z'/>\n    <path d='M80 75 l2 4 4 2 -4 2 -2 4 -2 -4 -4 -2 4 -2z'/>\n    <path d='M18 78 l1.5 3 3 1.5 -3 1.5 -1.5 3 -1.5 -3 -3 -1.5 3 -1.5z'/>\n    <path d='M50 8 l1.2 2.4 2.4 1.2 -2.4 1.2 -1.2 2.4 -1.2 -2.4 -2.4 -1.2 2.4 -1.2z'/>\n    <path d='M92 45 l1 2 2 1 -2 1 -1 2 -1 -2 -2 -1 2 -1z'/>\n    <path d='M7 48 l1 2 2 1 -2 1 -1 2 -1 -2 -2 -1 2 -1z'/>\n  </g>\n  <!-- ears -->\n  <circle cx='31' cy='26' r='10' fill='#C68642'/>\n  <circle cx='69' cy='26' r='10' fill='#C68642'/>\n  <circle cx='31' cy='26' r='5.5' fill='#E8B87A'/>\n  <circle cx='69' cy='26' r='5.5' fill='#E8B87A'/>\n  <!-- body -->\n  <ellipse cx='50' cy='72' rx='24' ry='20' fill='#A9712D'/>\n  <!-- belly -->\n  <ellipse cx='50' cy='75' rx='14' ry='13' fill='#E8B87A'/>\n  <!-- arms -->\n  <ellipse cx='26' cy='62' rx='9' ry='13' fill='#C68642' transform='rotate(25 26 62)'/>\n  <ellipse cx='74' cy='62' rx='9' ry='13' fill='#C68642' transform='rotate(-25 74 62)'/>\n  <!-- feet -->\n  <ellipse cx='37' cy='90' rx='9' ry='6' fill='#C68642'/>\n  <ellipse cx='63' cy='90' rx='9' ry='6' fill='#C68642'/>\n  <ellipse cx='37' cy='90' rx='4.5' ry='3' fill='#E8B87A'/>\n  <ellipse cx='63' cy='90' rx='4.5' ry='3' fill='#E8B87A'/>\n  <!-- head -->\n  <circle cx='50' cy='45' r='22' fill='#C68642'/>\n  <!-- muzzle -->\n  <ellipse cx='50' cy='52' rx='11' ry='8' fill='#E8B87A'/>\n  <!-- eyes -->\n  <circle cx='42' cy='42' r='3.5' fill='#3B2A1A'/>\n  <circle cx='58' cy='42' r='3.5' fill='#3B2A1A'/>\n  <circle cx='43' cy='41' r='1.2' fill='#FFFFFF'/>\n  <circle cx='59' cy='41' r='1.2' fill='#FFFFFF'/>\n  <!-- nose -->\n  <ellipse cx='50' cy='49' rx='3.5' ry='2.5' fill='#5A3A1A'/>\n  <!-- mouth -->\n  <path d='M46 53 q4 4 8 0' fill='none' stroke='#8B5E2E' stroke-width='1.5' stroke-linecap='round'/>\n  <line x1='50' y1='51.5' x2='50' y2='55' stroke='#8B5E2E' stroke-width='1.5' stroke-linecap='round'/>\n</svg>", "tags": ["teddy bear", "sparkles", "sparkly", "toy"]}