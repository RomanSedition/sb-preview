{"id": "sketch-a-bathtub-with-sparkles-around-it-4", "title": "Sparkly bathtub", "blurb": "", "svg": "<svg viewBox='0 0 100 100' xmlns='http://www.w3.org/2000/svg'>\n  <!-- sparkle rays background, subtle -->\n  <g stroke='#ffe066' stroke-width='2' stroke-linecap='round'>\n    <line x1='18' y1='16' x2='18' y2='24'/>\n    <line x1='14' y1='20' x2='22' y2='20'/>\n    <line x1='82' y1='14' x2='82' y2='22'/>\n    <line x1='78' y1='18' x2='86' y2='18'/>\n    <line x1='80' y1='40' x2='80' y2='47'/>\n    <line x1='76.5' y1='43.5' x2='83.5' y2='43.5'/>\n    <line x1='15' y1='45' x2='15' y2='52'/>\n    <line x1='11.5' y1='48.5' x2='18.5' y2='48.5'/>\n  </g>\n  <!-- sparkles (four-point stars) -->\n  <g fill='#fff59d'>\n    <path d='M30 10 L32 16 L38 18 L32 20 L30 26 L28 20 L22 18 L28 16 Z'/>\n    <path d='M70 60 L71.5 64.5 L76 66 L71.5 67.5 L70 72 L68.5 67.5 L64 66 L68.5 64.5 Z'/>\n    <path d='M88 74 L89 77 L92 78 L89 79 L88 82 L87 79 L84 78 L87 77 Z'/>\n    <path d='M12 74 L13 77 L16 78 L13 79 L12 82 L11 79 L8 78 L11 77 Z'/>\n  </g>\n  <!-- tub outer body -->\n  <path d='M16 46 Q10 46 10 54 L10 70 Q10 82 24 82 L76 82 Q90 82 90 70 L90 54 Q90 46 84 46 Z' fill='#e8f4fb'/>\n  <!-- tub rim highlight -->\n  <rect x='10' y='44' width='80' height='7' rx='3.5' fill='#ffffff'/>\n  <!-- tub inner shadow/shade to separate from rim -->\n  <path d='M16 51 Q10 51 10 58 L10 70 Q10 79 24 79 L76 79 Q90 79 90 70 L90 58 Q90 51 84 51 Z' fill='#bfe0f0'/>\n  <!-- water -->\n  <path d='M17 56 Q30 52 42 56 Q54 60 66 55 Q76 51 84 55 L84 62 Q60 58 17 62 Z' fill='#5cc4e8'/>\n  <!-- bubbles on water -->\n  <g fill='#ffffff' fill-opacity='0.9'>\n    <circle cx='26' cy='58' r='3.5'/>\n    <circle cx='34' cy='61' r='2.5'/>\n    <circle cx='45' cy='57' r='4'/>\n    <circle cx='55' cy='60' r='2.8'/>\n    <circle cx='64' cy='56' r='3.2'/>\n    <circle cx='74' cy='59' r='2.6'/>\n  </g>\n  <!-- water surface sparkle dot -->\n  <circle cx='50' cy='53' r='1.6' fill='#ffffff'/>\n  <!-- faucet top left -->\n  <rect x='30' y='34' width='10' height='14' rx='2' fill='#c9d6de'/>\n  <rect x='28' y='40' width='22' height='4' rx='2' fill='#c9d6de'/>\n  <rect x='31' y='30' width='8' height='6' rx='2' fill='#aebfc9'/>\n  <!-- drip -->\n  <circle cx='49' cy='47' r='1.8' fill='#5cc4e8'/>\n  <!-- feet -->\n  <circle cx='24' cy='84' r='4' fill='#7fb8d4'/>\n  <circle cx='76' cy='84' r='4' fill='#7fb8d4'/>\n  <!-- sparkle foreground -->\n  <path d='M50 70 L51.5 74.5 L56 76 L51.5 77.5 L50 82 L48.5 77.5 L44 76 L48.5 74.5 Z' fill='#fff59d'/>\n</svg>", "tags": ["bathtub", "sparkles", "sparkly", "home"]}