{"id": "sketch-a-windmill-with-sparkles-around-it", "title": "Sparkly windmill", "blurb": "", "svg": "<svg viewBox='0 0 100 100' xmlns='http://www.w3.org/2000/svg'>\n  <defs>\n    <linearGradient id='sky' x1='0' y1='0' x2='0' y2='1'>\n      <stop offset='0' stop-color='#3b2a6e'/>\n      <stop offset='1' stop-color='#1d1740'/>\n    </linearGradient>\n  </defs>\n  <!-- ground -->\n  <ellipse cx='50' cy='88' rx='46' ry='9' fill='#2f6b3c'/>\n  <ellipse cx='50' cy='88' rx='46' ry='9' fill='#3e8a4d' opacity='0.5'/>\n  <!-- tower -->\n  <path d='M42 86 L46 40 L54 40 L58 86 Z' fill='#c98b4b'/>\n  <path d='M42 86 L46 40 L50 40 L50 86 Z' fill='#e0a865'/>\n  <!-- door -->\n  <path d='M46.5 86 L47.5 72 L52.5 72 L53.5 86 Z' fill='#7a4a22'/>\n  <circle cx='52' cy='80' r='1.2' fill='#ffd76b'/>\n  <!-- window -->\n  <circle cx='50' cy='58' r='3' fill='#ffe28a'/>\n  <!-- roof cap -->\n  <path d='M44 41 L50 30 L56 41 Z' fill='#b03a3a'/>\n  <path d='M50 30 L50 41 L56 41 Z' fill='#d65353'/>\n  <!-- hub -->\n  <circle cx='50' cy='38' r='4' fill='#f0c04a'/>\n  <circle cx='50' cy='38' r='2' fill='#fff1b0'/>\n  <!-- blades -->\n  <g fill='#f7e9c4'>\n    <path d='M50 38 L49 8 L53 8 L53 38 Z'/>\n    <path d='M50 38 L49 8 L53 8 L53 38 Z' transform='rotate(90 50 38)'/>\n    <path d='M50 38 L49 8 L53 8 L53 38 Z' transform='rotate(180 50 38)'/>\n    <path d='M50 38 L49 8 L53 8 L53 38 Z' transform='rotate(270 50 38)'/>\n  </g>\n  <g fill='#d9b47a'>\n    <path d='M50 38 L50 8 L51.5 8 L51.5 38 Z'/>\n    <path d='M50 38 L50 8 L51.5 8 L51.5 38 Z' transform='rotate(90 50 38)'/>\n    <path d='M50 38 L50 8 L51.5 8 L51.5 38 Z' transform='rotate(180 50 38)'/>\n    <path d='M50 38 L50 8 L51.5 8 L51.5 38 Z' transform='rotate(270 50 38)'/>\n  </g>\n  <!-- sparkles -->\n  <g fill='#fff6c9'>\n    <path d='M18 22 l2 5 l5 2 l-5 2 l-2 5 l-2 -5 l-5 -2 l5 -2 Z'/>\n    <path d='M82 18 l1.6 4 l4 1.6 l-4 1.6 l-1.6 4 l-1.6 -4 l-4 -1.6 l4 -1.6 Z'/>\n    <path d='M86 62 l1.4 3.5 l3.5 1.4 l-3.5 1.4 l-1.4 3.5 l-1.4 -3.5 l-3.5 -1.4 l3.5 -1.4 Z'/>\n    <path d='M14 60 l1.4 3.5 l3.5 1.4 l-3.5 1.4 l-1.4 3.5 l-1.4 -3.5 l-3.5 -1.4 l3.5 -1.4 Z'/>\n    <path d='M30 10 l1 2.6 l2.6 1 l-2.6 1 l-1 2.6 l-1 -2.6 l-2.6 -1 l2.6 -1 Z'/>\n    <path d='M70 70 l1 2.6 l2.6 1 l-2.6 1 l-1 2.6 l-1 -2.6 l-2.6 -1 l2.6 -1 Z'/>\n  </g>\n  <g fill='#ffffff'>\n    <circle cx='22' cy='34' r='0.9'/>\n    <circle cx='78' cy='34' r='0.9'/>\n    <circle cx='40' cy='16' r='0.9'/>\n    <circle cx='64' cy='52' r='0.9'/>\n    <circle cx='24' cy='74' r='0.9'/>\n    <circle cx='76' cy='78' r='0.9'/>\n  </g>\n</svg>", "tags": ["windmill", "sparkles", "sparkly", "building"]}