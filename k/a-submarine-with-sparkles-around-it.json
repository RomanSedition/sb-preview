{"id": "sketch-a-submarine-with-sparkles-around-it", "title": "Sparkly submarine", "blurb": "", "svg": "<svg viewBox='0 0 100 100' xmlns='http://www.w3.org/2000/svg'>\n  <g>\n    <!-- Water sparkles -->\n    <g fill='#7fe7ff'>\n      <polygon points='18,22 20,28 26,30 20,32 18,38 16,32 10,30 16,28'/>\n      <polygon points='78,14 79.5,19 84,20.5 79.5,22 78,27 76.5,22 72,20.5 76.5,19'/>\n      <polygon points='88,48 89.5,52 93,53.5 89.5,55 88,59 86.5,55 83,53.5 86.5,52'/>\n      <polygon points='12,58 13.5,62 17,63.5 13.5,65 12,69 10.5,65 7,63.5 10.5,62'/>\n      <polygon points='82,76 83.5,80 87,81.5 83.5,83 82,87 80.5,83 77,81.5 80.5,80'/>\n      <polygon points='30,80 31,83 34,84 31,85 30,88 29,85 26,84 29,83'/>\n    </g>\n\n    <!-- Submarine body -->\n    <ellipse cx='50' cy='52' rx='34' ry='18' fill='#f6c445'/>\n    <!-- Bottom shading -->\n    <path d='M16 52 a34 18 0 0 0 68 0 a34 24 0 0 1 -68 0 z' fill='#d99a20'/>\n    <!-- Top highlight -->\n    <path d='M22 43 a34 18 0 0 1 56 0 a30 14 0 0 0 -56 0 z' fill='#ffe58a'/>\n\n    <!-- Portholes -->\n    <g>\n      <circle cx='40' cy='52' r='6' fill='#1e6fb0'/>\n      <circle cx='40' cy='52' r='6' fill='none' stroke='#8fd3ff' stroke-width='2'/>\n      <circle cx='38.5' cy='50' r='1.8' fill='#c8f0ff'/>\n      <circle cx='58' cy='52' r='6' fill='#1e6fb0'/>\n      <circle cx='58' cy='52' r='6' fill='none' stroke='#8fd3ff' stroke-width='2'/>\n      <circle cx='56.5' cy='50' r='1.8' fill='#c8f0ff'/>\n    </g>\n\n    <!-- Tail fin -->\n    <path d='M82 46 L94 38 L94 58 Z' fill='#e0552f'/>\n    <path d='M82 46 L94 50 L94 58 Z' fill='#b83c1e'/>\n\n    <!-- Top fin -->\n    <path d='M44 36 L50 26 L58 36 Z' fill='#e0552f'/>\n\n    <!-- Conning tower -->\n    <rect x='42' y='30' width='14' height='8' rx='3' fill='#f6c445'/>\n    <rect x='42' y='30' width='14' height='4' rx='2' fill='#ffe58a'/>\n\n    <!-- Periscope -->\n    <rect x='47' y='20' width='3' height='10' fill='#e0552f'/>\n    <rect x='47' y='18' width='7' height='3