{"id": "sketch-a-roller-skate-with-sparkles-around-it-4", "title": "Sparkly roller skate", "blurb": "", "svg": "<svg viewBox='0 0 100 100' xmlns='http://www.w3.org/2000/svg'>\n  <!-- sparkles -->\n  <g stroke='#fff4a0' stroke-width='2' stroke-linecap='round'>\n    <line x1='16' y1='18' x2='16' y2='28'/>\n    <line x1='11' y1='23' x2='21' y2='23'/>\n    <line x1='80' y1='12' x2='80' y2='22'/>\n    <line x1='75' y1='17' x2='85' y2='17'/>\n    <line x1='88' y1='40' x2='88' y2='48'/>\n    <line x1='84' y1='44' x2='92' y2='44'/>\n    <line x1='10' y1='52' x2='10' y2='60'/>\n    <line x1='6' y1='56' x2='14' y2='56'/>\n  </g>\n  <g fill='#fff9c4'>\n    <circle cx='30' cy='12' r='2.5'/>\n    <circle cx='68' cy='8' r='2'/>\n    <circle cx='92' cy='62' r='2.5'/>\n    <circle cx='6' cy='36' r='2'/>\n    <circle cx='22' cy='46' r='1.8'/>\n    <circle cx='82' cy='78' r='2'/>\n  </g>\n\n  <!-- boot -->\n  <path d='M34 22 L66 22 Q72 22 72 30 L72 52 Q72 58 66 58 L44 58 Q34 58 34 48 Z' fill='#ff5fa2'/>\n  <path d='M34 22 L66 22 Q72 22 72 30 L72 34 L34 34 Z' fill='#ff8fc0'/>\n  <!-- lace dots -->\n  <g fill='#fff0f6'>\n    <circle cx='44' cy='40' r='2.2'/>\n    <circle cx='52' cy='40' r='2.2'/>\n    <circle cx='60' cy='40' r='2.2'/>\n    <circle cx='44' cy='49' r='2.2'/>\n    <circle cx='52' cy='49' r='2.2'/>\n    <circle cx='60' cy='49' r='2.2'/>\n  </g>\n  <!-- tongue / toe cap -->\n  <path d='M34 52 L34 58 Q34 64 42 64 L72 64 Q78 64 78 58 L78 56 Q78 50 70 50 L34 52 Z' fill='#ffd6e7'/>\n  <path d='M70 50 Q80 52 80 60 Q80 66 72 66 L64 66 Q70 62 70 56 Z' fill='#ffbfd8'/>\n\n  <!-- sole -->\n  <rect x='32' y='64' width='50' height='9' rx='4' fill='#7a4bd1'/>\n  <rect x='33' y='65' width='48' height='3' rx='1.5' fill='#a37cf0'/>\n\n  <!-- wheels -->\n  <circle cx='44' cy='80' r='9' fill='#2fe0d0'/>\n  <circle cx='44' cy='80' r='4' fill='#b9fff8'/>\n  <circle cx='68' cy='80' r='9' fill='#2fe0d0'/>\n  <circle cx='68' cy='80' r='4' fill='#b9fff8'/>\n\n  <!-- sparkle on boot -->\n  <g stro