{"id": "sketch-a-lighthouse-with-sparkles-around-it", "title": "Sparkly lighthouse", "blurb": "", "svg": "<svg viewBox='0 0 100 100' xmlns='http://www.w3.org/2000/svg'>\n  <defs>\n    <linearGradient id='lhGrad' x1='0' y1='0' x2='1' y2='0'>\n      <stop offset='0%' stop-color='#ff4444'/>\n      <stop offset='50%' stop-color='#ff6666'/>\n      <stop offset='100%' stop-color='#cc2222'/>\n    </linearGradient>\n  </defs>\n  <!-- ground / rocky base -->\n  <ellipse cx='50' cy='88' rx='32' ry='10' fill='#5a4a7a'/>\n  <rect x='18' y='82' width='64' height='8' fill='#6b5b8a' rx='3'/>\n  <!-- lighthouse body -->\n  <polygon points='40,82 60,82 57,40 43,40' fill='#ff5555'/>\n  <polygon points='40,82 60,82 57,40 43,40' fill='none' stroke='#ff9999' stroke-width='1'/>\n  <!-- white stripes -->\n  <rect x='42.5' y='55' width='15' height='8' fill='#ffffff' opacity='0.9'/>\n  <rect x='41.5' y='68' width='17' height='8' fill='#ffffff' opacity='0.9'/>\n  <rect x='43.5' y='44' width='13' height='6' fill='#ffffff' opacity='0.9'/>\n  <!-- lantern room -->\n  <rect x='43' y='30' width='14' height='11' fill='#ffcc44' rx='1'/>\n  <!-- light beam -->\n  <polygon points='50,33 15,20 15,28' fill='#ffee88' opacity='0.35'/>\n  <polygon points='50,33 85,20 85,28' fill='#ffee88' opacity='0.35'/>\n  <!-- roof -->\n  <polygon points='38,31 62,31 50,18' fill='#cc2222'/>\n  <polygon points='38,31 62,31 50,18' fill='none' stroke='#ff7777' stroke-width='1'/>\n  <!-- top knob -->\n  <circle cx='50' cy='17' r='2.5' fill='#ffdd55'/>\n  <!-- door -->\n  <rect x='46' y='74' width='8' height='8' fill='#884422' rx='3'/>\n  <!-- window -->\n  <circle cx='50' cy='62' r='2.5' fill='#ffcc44'/>\n  <!-- sparkles -->\n  <g fill='#ffee77'>\n    <polygon points='20,30 21.5,34 25,34 22.5,36.5 23.5,40 20,38 16.5,40 17.5,36.5 15,34 18.5,34'/>\n    <polygon points='78,42 79.2,45.5 82.5,45.5 80,47.5 81,50.5 78,48.8 75,50.5 76,47.5 73.5,45.5 76.8,45.5'/>\n    <polygon points='30,22 31,24.8 34,24.8 31.5,26.5 32.5,29 30,27.5 27.5,29 28.5,26.5 26,24.8 29,24.8'/>\n    <polygon points='70,28 70.8,30.4 73.5,30.4 71.5,32 72.2,34 70,32.8 67.8,34 68.5,32 66.5,30.4 69.2,30.4'/>\n    <polygon points='82,65 83,67.5 85.8,67.5 83.5,69.2 84.3,71.5 82,70.2 79.7,71.5 80.5,69.2 78.2,67.5 81,67.5'/>\n    <polygon points='15,55 16,57.5 18.8,57.5 16.5,59.2 17.5,61.5 15,60.2 12.5,61.5 13.5,59.2 11.2,57.5 14,57.5'/>\n  </g>\n  <g fill='#aaddff'>\n    <circle cx='25' cy='45' r='1.2'/>\n    <circle cx='75' cy='55' r='1.2'/>\n    <circle cx='35' cy='15' r='1'/>\n    <circle cx='65' cy='12' r='1'/>\n    <circle cx='88' cy='35' r='1'/>\n    <circle cx='10' cy='70' r='1'/>\n  </g>\n</svg>", "tags": ["lighthouse", "sparkles", "sparkly", "building"]}