{"id": "sketch-a-flower-pot-with-sparkles-around-it-4", "title": "Sparkly flower pot", "blurb": "", "svg": "<svg viewBox='0 0 100 100' xmlns='http://www.w3.org/2000/svg'>\n  <g>\n    <!-- sparkles -->\n    <g fill='#ffee55'>\n      <polygon points='18,20 20,26 26,28 20,30 18,36 16,30 10,28 16,26'/>\n      <polygon points='82,14 83.5,18 88,19.5 83.5,21 82,25 80.5,21 76,19.5 80.5,18'/>\n      <polygon points='78,60 79.5,64 84,65.5 79.5,67 78,71 76.5,67 72,65.5 76.5,64'/>\n      <polygon points='14,62 15.5,66 20,67.5 15.5,69 14,73 12.5,69 8,67.5 12.5,66'/>\n      <polygon points='50,8 51.5,12 56,13.5 51.5,15 50,19 48.5,15 44,13.5 48.5,12'/>\n    </g>\n    <!-- stem and leaves -->\n    <rect x='47' y='42' width='6' height='20' rx='2' fill='#3cb043'/>\n    <ellipse cx='38' cy='50' rx='10' ry='5' fill='#4cd15f' transform='rotate(-25 38 50)'/>\n    <ellipse cx='62' cy='48' rx='10' ry='5' fill='#4cd15f' transform='rotate(25 62 48)'/>\n    <!-- flower petals -->\n    <g fill='#ff5fa2'>\n      <ellipse cx='50' cy='22' rx='7' ry='10'/>\n      <ellipse cx='50' cy='42' rx='7' ry='10'/>\n      <ellipse cx='40' cy='32' rx='10' ry='7'/>\n      <ellipse cx='60' cy='32' rx='10' ry='7'/>\n      <ellipse cx='43' cy='24' rx='8' ry='7' transform='rotate(-45 43 24)'/>\n      <ellipse cx='57' cy='24' rx='8' ry='7' transform='rotate(45 57 24)'/>\n      <ellipse cx='43' cy='40' rx='8' ry='7' transform='rotate(45 43 40)'/>\n      <ellipse cx='57' cy='40' rx='8' ry='7' transform='rotate(-45 57 40)'/>\n    </g>\n    <!-- flower center -->\n    <circle cx='50' cy='32' r='7' fill='#ffcc00'/>\n    <circle cx='50' cy='32' r='3.5' fill='#ff9900'/>\n    <!-- pot rim -->\n    <rect x='30' y='60' width='40' height='8' rx='3' fill='#e07b3c'/>\n    <rect x='30' y='61' width='40' height='3' rx='2' fill='#f59b55'/>\n    <!-- pot body -->\n    <path d='M34 68 L38 92 L62 92 L66 68 Z' fill='#c85a2a'/>\n    <path d='M36 68 L38.5 90 L45 90 L43 68 Z' fill='#da6e3e'/>\n    <path d='M55 68 L57 90 L61.5 90 L64 68 Z