{"id": "sketch-a-bicycle-with-sparkles-around-it-4", "title": "Sparkly bicycle", "blurb": "", "svg": "<svg viewBox='0 0 100 100' xmlns='http://www.w3.org/2000/svg'>\n  <!-- Sparkles -->\n  <g fill='#FFE74C'>\n    <polygon points='15,15 17,21 23,23 17,25 15,31 13,25 7,23 13,21'/>\n    <polygon points='85,10 86.5,14 90,15.5 86.5,17 85,21 83.5,17 80,15.5 83.5,14'/>\n    <polygon points='90,70 91.5,74 95,75.5 91.5,77 90,81 88.5,77 85,75.5 88.5,74'/>\n    <polygon points='10,75 11.5,79 15,80.5 11.5,82 10,86 8.5,82 5,80.5 8.5,79'/>\n    <polygon points='50,5 51.5,9 55,10.5 51.5,12 50,16 48.5,12 45,10.5 48.5,9'/>\n    <polygon points='25,88 26.5,92 30,93.5 26.5,95 25,99 23.5,95 20,93.5 23.5,92'/>\n  </g>\n\n  <!-- Rear wheel -->\n  <circle cx='25' cy='65' r='18' fill='none' stroke='#4FC3F7' stroke-width='3.5'/>\n  <circle cx='25' cy='65' r='3' fill='#4FC3F7'/>\n  <!-- Rear spokes -->\n  <g stroke='#4FC3F7' stroke-width='1.5'>\n    <line x1='25' y1='47' x2='25' y2='83'/>\n    <line x1='7' y1='65' x2='43' y2='65'/>\n    <line x1='12.3' y1='52.3' x2='37.7' y2='77.7'/>\n    <line x1='12.3' y1='77.7' x2='37.7' y2='52.3'/>\n  </g>\n\n  <!-- Front wheel -->\n  <circle cx='75' cy='65' r='18' fill='none' stroke='#4FC3F7' stroke-width='3.5'/>\n  <circle cx='75' cy='65' r='3' fill='#4FC3F7'/>\n  <!-- Front spokes -->\n  <g stroke='#4FC3F7' stroke-width='1.5'>\n    <line x1='75' y1='47' x2='75' y2='83'/>\n    <line x1='57' y1='65' x2='93' y2='65'/>\n    <line x1='62.3' y1='52.3' x2='87.7' y2='77.7'/>\n    <line x1='62.3' y1='77.7' x2='87.7' y2='52.3'/>\n  </g>\n\n  <!-- Frame -->\n  <g stroke='#FF6B6B' stroke-width='4' stroke-linecap='round' stroke-linejoin='round' fill='none'>\n    <!-- Seat tube -->\n    <line x1='42' y1='42' x2='38' y2='65'/>\n    <!-- Down tube -->\n    <line x1='42' y1='42' x2='65' y2='60'/>\n    <!-- Chain stay -->\n    <line x1='38' y1='65' x2='25' y2='65'/>\n    <!-- Seat stay -->\n    <line x1='42' y1='42' x2='25' y2='65'/>\n    <!-- Top tube -->\n    <line x1='42' y1='42' x2='65' y2='42'/>\n    <!-- Head tube -->\n    <line x1='65' y1='42' x2='70' y2='55'/>\n    <!-- Fork -->\n    <line x1='70' y1='55' x2='75' y2='65'/>\n    <!-- Front top tube to head -->\n    <line x1='65' y1='42' x2='70' y2='55'/>\n  </g>\n\n  <!-- Seat -->\n  <ellipse cx='42' cy='38' rx='8' ry='4' fill='#FFD93D'/>\n\n  <!-- Handlebar -->\n  <g stroke='#FFD93D' stroke-width='3.5' stroke-linecap='round' fill='none'>\n    <line x1='64' y1='40' x2='70' y2='32'/>\n    <line x1='70' y1='32' x2='76' y2='36'/>\n  </g>\n\n  <!-- Pedal crank -->\n  <circle cx='38' cy='65' r='6' fill='#FF6B6B' stroke='#FF8E8E' stroke-width='1.5'/>\n  <line x1='32' y1='59' x2='44' y2='71' stroke='#FFD93D' stroke-width='2.5' stroke-linecap='round'/>\n  <!-- Pedals -->\n  <rect x='29' y='56' width='6' height='3' rx='1.5' fill='#FFD93D' transform='rotate(45,32,57.5)'/>\n  <rect x='41' y='68' width='6' height='3' rx='1.5' fill='#FFD93D' transform='rotate(45,44,69.5)'/>\n\n  <!-- Chain -->\n  <ellipse cx='31.5' cy='65' rx='8' ry='3' fill='none' stroke='#B0BEC5' stroke-width='1.5' transform='rotate(-10,31.5,65)'/>\n\n  <!-- Extra sparkles near wheels -->\n  <g fill='#FFE74C'>\n    <polygon points='50,40 51,43.5 54,44.5 51,45.5 50,49 49,45.5 46,44.5 49,43.5'/>\n    <polygon points='60,78 61,81.5 64,82.5 61,83.5 60,87 59,83.5 56,82.5 59,81.5'/>\n    <polygon points='35,25 36,28.5 39,29.5 36,30.5 35,34 34,30.5 31,29.5 34,28.5'/>\n    <circle cx='78' cy='30' r='2' fill='#FFE74C'/>\n    <circle cx='20' cy='45' r='1.8' fill='#FFE74C'/>\n    <circle cx='45' cy='80' r='1.5' fill='#FFE74C'/>\n    <circle cx='90' cy='50' r='1.8' fill='#FFE74C'/>\n  </g>\n</svg>", "tags": ["bicycle", "sparkles", "sparkly", "vehicle"]}