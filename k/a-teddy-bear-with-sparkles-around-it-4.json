{"id": "sketch-a-teddy-bear-with-sparkles-around-it-4", "title": "Sparkly teddy bear", "blurb": "", "svg": "<svg viewBox='0 0 100 100' xmlns='http://www.w3.org/2000/svg'>\n  <!-- sparkles -->\n  <g fill='#FFE96B'>\n    <path d='M18 20 l2 5 5 2 -5 2 -2 5 -2 -5 -5 -2 5 -2z'/>\n    <path d='M82 24 l2 5 5 2 -5 2 -2 5 -2 -5 -5 -2 5 -2z'/>\n    <path d='M12 62 l2 4 4 2 -4 2 -2 4 -2 -4 -4 -2 4 -2z'/>\n    <path d='M88 60 l2 4 4 2 -4 2 -2 4 -2 -4 -4 -2 4 -2z'/>\n    <path d='M50 8 l2 4 4 2 -4 2 -2 4 -2 -4 -4 -2 4 -2z'/>\n    <path d='M28 82 l1.5 3.5 3.5 1.5 -3.5 1.5 -1.5 3.5 -1.5 -3.5 -3.5 -1.5 3.5 -1.5z'/>\n    <path d='M72 84 l1.5 3.5 3.5 1.5 -3.5 1.5 -1.5 3.5 -1.5 -3.5 -3.5 -1.5 3.5 -1.5z'/>\n  </g>\n  <!-- ears -->\n  <circle cx='30' cy='32' r='11' fill='#A9702F'/>\n  <circle cx='70' cy='32' r='11' fill='#A9702F'/>\n  <circle cx='30' cy='32' r='6' fill='#E8A86B'/>\n  <circle cx='70' cy='32' r='6' fill='#E8A86B'/>\n  <!-- head -->\n  <circle cx='50' cy='44' r='24' fill='#C98A45'/>\n  <!-- muzzle -->\n  <ellipse cx='50' cy='52' rx='13' ry='10' fill='#EDB883'/>\n  <!-- eyes -->\n  <circle cx='41' cy='40' r='3.2' fill='#3B2413'/>\n  <circle cx='59' cy='40' r='3.2' fill='#3B2413'/>\n  <circle cx='42' cy='39' r='1' fill='#FFE9C9'/>\n  <circle cx='60' cy='39' r='1' fill='#FFE9C9'/>\n  <!-- nose -->\n  <ellipse cx='50' cy='48' rx='3.5' ry='2.5' fill='#3B2413'/>\n  <!-- mouth -->\n  <path d='M50 51 v3 M50 54 q-4 3 -7 0 M50 54 q4 3 7 0' stroke='#3B2413' stroke-width='1.6' fill='none' stroke-linecap='round'/>\n  <!-- body -->\n  <ellipse cx='50' cy='80' rx='20' ry='18' fill='#C98A45'/>\n  <!-- belly -->\n  <ellipse cx='50' cy='82' rx='12' ry='13' fill='#EDB883'/>\n  <!-- arms -->\n  <ellipse cx='30' cy='74' rx='8' ry='11' fill='#A9702F' transform='rotate(20 30 74)'/>\n  <ellipse cx='70' cy='74' rx='8' ry='11' fill='#A9702F' transform='rotate(-20 70 74)'/>\n  <!-- feet -->\n  <ellipse cx='38' cy='95' rx='9' ry='6' fill='#A9702F'/>\n  <ellipse cx='62' cy='95' rx='9' ry='6' fill='#A9