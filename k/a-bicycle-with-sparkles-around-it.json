{"id": "sketch-a-bicycle-with-sparkles-around-it", "title": "Sparkly bicycle", "blurb": "", "svg": "<svg viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\">\n  <!-- Sparkles -->\n  <g fill=\"#FFE45C\">\n    <polygon points=\"15,15 17,21 23,23 17,25 15,31 13,25 7,23 13,21\" />\n    <polygon points=\"85,20 86.5,24 91,25.5 86.5,27 85,31 83.5,27 79,25.5 83.5,24\" />\n    <polygon points=\"80,70 81.5,74 86,75.5 81.5,77 80,81 78.5,77 74,75.5 78.5,74\" />\n    <polygon points=\"20,75 21.5,79 26,80.5 21.5,82 20,86 18.5,82 14,80.5 18.5,79\" />\n    <polygon points=\"50,8 51.5,12 56,13.5 51.5,15 50,19 48.5,15 44,13.5 48.5,12\" />\n  </g>\n  <!-- Wheels -->\n  <g stroke=\"#5CE1E6\" stroke-width=\"3.5\" fill=\"none\">\n    <circle cx=\"27\" cy=\"65\" r=\"17\" />\n    <circle cx=\"73\" cy=\"65\" r=\"17\" />\n  </g>\n  <!-- Wheel hubs -->\n  <circle cx=\"27\" cy=\"65\" r=\"3\" fill=\"#FF7AB6\" />\n  <circle cx=\"73\" cy=\"65\" r=\"3\" fill=\"#FF7AB6\" />\n  <!-- Spokes -->\n  <g stroke=\"#7EE0FF\" stroke-width=\"1.2\" opacity=\"0.8\">\n    <line x1=\"27\" y1=\"48\" x2=\"27\" y2=\"82\" />\n    <line x1=\"10\" y1=\"65\" x2=\"44\" y2=\"65\" />\n    <line x1=\"15\" y1=\"53\" x2=\"39\" y2=\"77\" />\n    <line x1=\"39\" y1=\"53\" x2=\"15\" y2=\"77\" />\n    <line x1=\"73\" y1=\"48\" x2=\"73\" y2=\"82\" />\n    <line x1=\"56\" y1=\"65\" x2=\"90\" y2=\"65\" />\n    <line x1=\"61\" y1=\"53\" x2=\"85\" y2=\"77\" />\n    <line x1=\"85\" y1=\"53\" x2=\"61\" y2=\"77\" />\n  </g>\n  <!-- Frame -->\n  <g stroke=\"#FF9F43\" stroke-width=\"4\" fill=\"none\" stroke-linecap=\"round\">\n    <line x1=\"27\" y1=\"65\" x2=\"43\" y2=\"40\" />\n    <line x1=\"43\" y1=\"40\" x2=\"65\" y2=\"40\" />\n    <line x1=\"65\" y1=\"40\" x2=\"73\" y2=\"65\" />\n    <line x1=\"43\" y1=\"40\" x2=\"50\" y2=\"65\" />\n    <line x1=\"50\" y1=\"65\" x2=\"73\" y2=\"65\" />\n    <line x1=\"50\" y1=\"65\" x2=\"27\" y2=\"65\" />\n    <line x1=\"43\" y1=\"40\" x2=\"41\" y2=\"30\" />\n  </g>\n  <!-- Seat -->\n  <ellipse cx=\"65\" cy=\"37\" rx=\"8\" ry=\"3.5\" fill=\"#B06CFF\" />\n  <!-- Handlebar -->\n  <line x1=\"43\" y1=\"40\" x2=\"55\" y2=\"26\" stroke=\"#FF9F43\" stroke-width=\"4\" stroke-linecap=\"round\" />\n  <line x1=\"48\" y1=\"24\" x2=\"62\" y2=\"24\" stroke=\"#FF9F43\" stroke-width=\"4\" stroke-linecap=\"round\" />\n  <!-- Pedal -->\n  <circle cx=\"50\" cy=\"65\" r=\"4\" fill=\"#FF7AB6\" />\n  <line x1=\"50\" y1=\"65\" x2=\"55\" y2=\"72\" stroke=\"#FF9F43\" stroke-width=\"2.5\" stroke-linecap=\"round\" />\n</svg>", "tags": ["bicycle", "sparkles", "sparkly", "vehicle"]}