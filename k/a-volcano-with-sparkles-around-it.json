{"id": "sketch-a-volcano-with-sparkles-around-it", "title": "Sparkly volcano", "blurb": "", "svg": "<svg viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\">\n  <!-- Sparkles - yellow and white stars around the volcano -->\n  <g fill=\"#FFE44D\">\n    <polygon points=\"15,20 17,26 23,26 18,30 20,36 15,32 10,36 12,30 7,26 13,26\"/>\n    <polygon points=\"82,15 84,20 89,20 85,23 87,28 82,25 77,28 79,23 75,20 80,20\"/>\n    <polygon points=\"88,45 89,49 93,49 90,51 91,55 88,53 85,55 86,51 83,49 87,49\"/>\n    <polygon points=\"10,55 11,59 15,59 12,61 13,65 10,63 7,65 8,61 5,59 9,59\"/>\n    <polygon points=\"25,10 26,13 29,13 27,15 28,18 25,16 22,18 23,15 21,13 24,13\"/>\n  </g>\n  <g fill=\"#FFFFFF\">\n    <polygon points=\"70,8 71,11 74,11 72,13 73,16 70,14 67,16 68,13 66,11 69,11\"/>\n    <polygon points=\"92,62 93,65 96,65 94,67 95,70 92,68 89,70 90,67 88,65 91,65\"/>\n    <polygon points=\"8,80 9,83 12,83 10,85 11,88 8,86 5,88 6,85 4,83 7,83\"/>\n  </g>\n\n  <!-- Sky glow behind volcano -->\n  <ellipse cx=\"50\" cy=\"62\" rx=\"38\" ry=\"22\" fill=\"#3A1A4A\" opacity=\"0.6\"/>\n\n  <!-- Eruption glow -->\n  <ellipse cx=\"50\" cy=\"38\" rx=\"18\" ry=\"12\" fill=\"#FF6B2B\" opacity=\"0.5\"/>\n\n  <!-- Lava spray / eruption bits -->\n  <g fill=\"#FF8C42\">\n    <circle cx=\"40\" cy=\"22\" r=\"3\"/>\n    <circle cx=\"55\" cy=\"18\" r=\"2.5\"/>\n    <circle cx=\"48\" cy=\"14\" r=\"2\"/>\n    <circle cx=\"62\" cy=\"26\" r=\"2.5\"/>\n    <circle cx=\"35\" cy=\"32\" r=\"2\"/>\n    <circle cx=\"65\" cy=\"36\" r=\"2\"/>\n  </g>\n  <g fill=\"#FFC94D\">\n    <circle cx=\"44\" cy=\"18\" r=\"1.5\"/>\n    <circle cx=\"58\" cy=\"22\" r=\"1.5\"/>\n    <circle cx=\"38\" cy=\"26\" r=\"1.5\"/>\n    <circle cx=\"52\" cy=\"12\" r=\"1.5\"/>\n  </g>\n\n  <!-- Main volcano body -->\n  <polygon points=\"50,40 18,85 82,85\" fill=\"#8B4513\"/>\n\n  <!-- Volcano body lighter side (left) -->\n  <polygon points=\"50,40 18,85 50,85\" fill=\"#A0522D\"/>\n\n  <!-- Volcano surface ridges (dark reddish) -->\n  <polygon points=\"50,40 42,55 46,60 40,72 44,78 38,85 50,85 50,40\" fill=\"#7A3B10\" opacity=\"0.5\"/>\n\n  <!-- Crater rim -->\n  <ellipse cx=\"50\" cy=\"42\" rx=\"12\" ry=\"5\" fill=\"#6B3410\"/>\n  <ellipse cx=\"50\" cy=\"41\" rx=\"10\" ry=\"3.5\" fill=\"#FF6B2B\"/>\n\n  <!-- Lava flow down the side -->\n  <g fill=\"#FF4422\">\n    <path d=\"M46,43 Q44,55 47,65 Q45,72 48,80 L52,80 Q50,72 52,65 Q50,55 54,43 Z\"/>\n  </g>\n  <g fill=\"#FF8C42\">\n    <path d=\"M47,45 Q46,54 48,63 L50,63 Q49,54 50,45 Z\"/>\n  </g>\n\n  <!-- Lava glow spots on body -->\n  <g fill=\"#FFAA33\">\n    <circle cx=\"36\" cy=\"70\" r=\"2\"/>\n    <circle cx=\"63\" cy=\"65\" r=\"2.5\"/>\n    <circle cx=\"70\" cy=\"78\" r=\"1.5\"/>\n    <circle cx=\"30\" cy=\"80\" r=\"2\"/>\n  </g>\n\n  <!-- Base ground glow -->\n  <ellipse cx=\"50\" cy=\"85\" rx=\"36\" ry=\"4\" fill=\"#FF6B2B\" opacity=\"0.4\"/>\n\n  <!-- Snow/sparkle bits on volcano slopes -->\n  <g fill=\"#FFE44D\">\n    <circle cx=\"33\" cy=\"78\" r=\"1.2\"/>\n    <circle cx=\"58\" cy=\"72\" r=\"1.2\"/>\n    <circle cx=\"42\" cy=\"82\" r=\"1\"/>\n    <circle cx=\"66\" cy=\"82\" r=\"1\"/>\n  </g>\n</svg>", "tags": ["volcano", "sparkles", "sparkly", "nature"]}