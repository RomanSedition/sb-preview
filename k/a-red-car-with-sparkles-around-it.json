{"id": "sketch-a-red-car-with-sparkles-around-it", "title": "Sparkly red car", "blurb": "", "svg": "<svg viewBox='0 0 100 100' xmlns='http://www.w3.org/2000/svg'>\n  <!-- sparkles -->\n  <g fill='#FFF176'>\n    <polygon points='15,20 17,26 23,28 17,30 15,36 13,30 7,28 13,26'/>\n    <polygon points='82,14 84,19 89,21 84,23 82,28 80,23 75,21 80,19'/>\n    <polygon points='88,60 90,65 95,67 90,69 88,74 86,69 81,67 86,65'/>\n    <polygon points='12,70 14,75 19,77 14,79 12,84 10,79 5,77 10,75'/>\n    <polygon points='50,8 52,13 57,15 52,17 50,22 48,17 43,15 48,13'/>\n    <circle cx='70' cy='45' r='2'/>\n    <circle cx='28' cy='50' r='1.5'/>\n    <circle cx='75' cy='80' r='1.5'/>\n    <circle cx='22' cy='35' r='1.5'/>\n  </g>\n  <!-- car body shadow/underside -->\n  <rect x='18' y='62' width='64' height='8' rx='4' fill='#8B1A1A'/>\n  <!-- car body -->\n  <path d='M20 58 L22 46 Q24 38 32 36 L42 35 Q48 28 56 28 L64 28 Q72 28 76 36 L80 46 L82 58 Q82 64 76 64 L24 64 Q20 64 20 58 Z' fill='#E53935'/>\n  <!-- windshield -->\n  <path d='M44 36 Q48 30 54 30 L62 30 Q68 30 71 36 L73 44 L43 44 Z' fill='#90CAF9'/>\n  <!-- windshield shine -->\n  <path d='M47 34 L52 34 L49 42 L44 42 Z' fill='#BBDEFB' opacity='0.7'/>\n  <!-- side window -->\n  <path d='M34 38 Q36 34 40 33 L41 33 L42 44 L32 44 Z' fill='#90CAF9'/>\n  <!-- door line -->\n  <line x1='52' y1='46' x2='52' y2='62' stroke='#C62828' stroke-width='1.5'/>\n  <!-- handle -->\n  <rect x='46' y='50' width='6' height='2' rx='1' fill='#FFCDD2'/>\n  <!-- headlight -->\n  <ellipse cx='79' cy='50' rx='3' ry='4' fill='#FFF59D'/>\n  <!-- taillight -->\n  <ellipse cx='21' cy='50' rx='2.5' ry='3.5' fill='#FF8A80'/>\n  <!-- front bumper highlight -->\n  <rect x='76' y='57' width='4' height='3' rx='1.5' fill='#EF9A9A'/>\n  <!-- wheels -->\n  <circle cx='32' cy='64' r='8' fill='#37474F'/>\n  <circle cx='32' cy='64' r='4' fill='#B0BEC5'/>\n  <circle cx='68' cy='64' r='8' fill='#37474F'/>\n  <circle cx='68' cy='64' r='4' fill='#B0BEC5'/>\n  <!-- w