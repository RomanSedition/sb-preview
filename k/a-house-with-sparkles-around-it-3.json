{"id": "sketch-a-house-with-sparkles-around-it-3", "title": "Sparkly house", "blurb": "", "svg": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 100 100\">\n  <!-- ground -->\n  <rect x=\"8\" y=\"78\" width=\"84\" height=\"10\" rx=\"3\" fill=\"#3fa34d\"/>\n  <!-- house body -->\n  <rect x=\"26\" y=\"47\" width=\"48\" height=\"32\" fill=\"#f2c14e\"/>\n  <rect x=\"26\" y=\"47\" width=\"48\" height=\"6\" fill=\"#f9d97a\"/>\n  <!-- roof -->\n  <polygon points=\"50,20 20,49 80,49\" fill=\"#e2574c\"/>\n  <polygon points=\"50,20 20,49 30,49\" fill=\"#f07261\"/>\n  <!-- chimney -->\n  <rect x=\"62\" y=\"26\" width=\"9\" height=\"18\" fill=\"#c94a3f\"/>\n  <rect x=\"60\" y=\"24\" width=\"13\" height=\"4\" rx=\"1\" fill=\"#e2574c\"/>\n  <!-- door -->\n  <rect x=\"44\" y=\"58\" width=\"14\" height=\"21\" rx=\"2\" fill=\"#8a5a2b\"/>\n  <circle cx=\"54\" cy=\"69\" r=\"1.8\" fill=\"#f9d97a\"/>\n  <!-- windows -->\n  <rect x=\"32\" y=\"55\" width=\"9\" height=\"9\" rx=\"1\" fill=\"#7fd4f2\"/>\n  <rect x=\"60\" y=\"55\" width=\"9\" height=\"9\" rx=\"1\" fill=\"#7fd4f2\"/>\n  <line x1=\"36.5\" y1=\"55\" x2=\"36.5\" y2=\"64\" stroke=\"#cdeefb\" stroke-width=\"1.2\"/>\n  <line x1=\"32\" y1=\"59.5\" x2=\"41\" y2=\"59.5\" stroke=\"#cdeefb\" stroke-width=\"1.2\"/>\n  <line x1=\"64.5\" y1=\"55\" x2=\"64.5\" y2=\"64\" stroke=\"#cdeefb\" stroke-width=\"1.2\"/>\n  <line x1=\"60\" y1=\"59.5\" x2=\"69\" y2=\"59.5\" stroke=\"#cdeefb\" stroke-width=\"1.2\"/>\n  <!-- sparkles -->\n  <g fill=\"#ffffff\">\n    <path d=\"M14 20 l1.6 3.4 3.4 1.6 -3.4 1.6 -1.6 3.4 -1.6 -3.4 -3.4 -1.6 3.4 -1.6 z\"/>\n    <path d=\"M86 26 l1.3 2.8 2.8 1.3 -2.8 1.3 -1.3 2.8 -1.3 -2.8 -2.8 -1.3 2.8 -1.3 z\"/>\n    <path d=\"M88 58 l1.2 2.6 2.6 1.2 -2.6 1.2 -1.2 2.6 -1.2 -2.6 -2.6 -1.2 2.6 -1.2 z\"/>\n    <path d=\"M12 52 l1.2 2.6 2.6 1.2 -2.6 1.2 -1.2 2.6 -1.2 -2.6 -2.6 -1.2 2.6 -1.2 z\"/>\n    <path d=\"M18 34 l1 2.2 2.2 1 -2.2 1 -1 2.2 -1 -2.2 -2.2 -1 2.2 -1 z\"/>\n    <path d=\"M82 40 l1 2.2 2.2 1 -2.2 1 -1 2.