{"id": "sketch-a-snowflake-with-a-smiling-face-2", "title": "Snowflake with a smiling face", "blurb": "", "svg": "<svg viewBox='0 0 100 100' xmlns='http://www.w3.org/2000/svg'>\n  <!-- main snowflake arms - 6 arms from center -->\n  <g stroke='#aee8ff' stroke-width='3.5' stroke-linecap='round' fill='none'>\n    <!-- vertical -->\n    <line x1='50' y1='10' x2='50' y2='90'/>\n    <!-- diagonal 60 deg -->\n    <line x1='15.4' y1='30' x2='84.6' y2='70'/>\n    <!-- diagonal 120 deg -->\n    <line x1='84.6' y1='30' x2='15.4' y2='70'/>\n  </g>\n\n  <!-- arm branches (V shapes) at tips -->\n  <g stroke='#c9f0ff' stroke-width='2.5' stroke-linecap='round' fill='none'>\n    <!-- top -->\n    <line x1='50' y1='18' x2='41' y2='26'/>\n    <line x1='50' y1='18' x2='59' y2='26'/>\n    <!-- bottom -->\n    <line x1='50' y1='82' x2='41' y2='74'/>\n    <line x1='50' y1='82' x2='59' y2='74'/>\n    <!-- top-right -->\n    <line x1='78' y1='33' x2='74' y2='44'/>\n    <line x1='78' y1='33' x2='67' y2='27'/>\n    <!-- bottom-left -->\n    <line x1='22' y1='67' x2='26' y2='56'/>\n    <line x1='22' y1='67' x2='33' y2='73'/>\n    <!-- top-left -->\n    <line x1='22' y1='33' x2='26' y2='44'/>\n    <line x1='22' y1='33' x2='33' y2='27'/>\n    <!-- bottom-right -->\n    <line x1='78' y1='67' x2='74' y2='56'/>\n    <line x1='78' y1='67' x2='67' y2='73'/>\n  </g>\n\n  <!-- small mid-arm branches -->\n  <g stroke='#8fd8f5' stroke-width='2' stroke-linecap='round' fill='none'>\n    <line x1='50' y1='30' x2='44' y2='36'/>\n    <line x1='50' y1='30' x2='56' y2='36'/>\n    <line x1='50' y1='70' x2='44' y2='64'/>\n    <line x1='50' y1='70' x2='56' y2='64'/>\n    <line x1='63' y1='42' x2='58' y2='47'/>\n    <line x1='63' y1='42' x2='68' y2='37'/>\n    <line x1='37' y1='58' x2='42' y2='53'/>\n    <line x1='37' y1='58' x2='32' y2='63'/>\n    <line x1='37' y1='42' x2='42' y2='47'/>\n    <line x1='37' y1='42' x2='32' y2='37'/>\n    <line x1='63' y1='58' x2='58' y2='53'/>\n    <line x1='63' y1='58' x2='68' y2='63'/>\n  </g>\n\n  <!-- center hexagon -->\n  <polygon points='50,36 62,43 62,57 50,64 38,57 38,43' fill='#5ec8e8' stroke='#aee8ff' stroke-width='2.5'/>\n\n  <!-- smiling face -->\n  <!-- eyes -->\n  <circle cx='44' cy='45' r='3' fill='#1a3a5c'/>\n  <circle cx='56' cy='45' r='3' fill='#1a3a5c'/>\n  <!-- eye highlights -->\n  <circle cx='45' cy='44' r='1' fill='#e0f7ff'/>\n  <circle cx='57' cy='44' r='1' fill='#e0f7ff'/>\n\n  <!-- smile -->\n  <path d='M43 52 Q50 60 57 52' stroke='#1a3a5c' stroke-width='2.5' stroke-linecap='round' fill='none'/>\n\n  <!-- rosy cheeks -->\n  <circle cx='39' cy='51' r='3' fill='#ff9eb5' opacity='0.8'/>\n  <circle cx='61' cy='51' r='3' fill='#ff9eb5' opacity='0.8'/>\n\n  <!-- sparkle accents -->\n  <g fill='#e0f7ff'>\n    <polygon points='15,15 17,20 22,20 18,23 19.5,28 15,25 10.5,28 12,23 8,20 13,20' transform='scale(0.55) translate(10,5)'/>\n    <polygon points='15,15 17,20 22,20 18,23 19.5,28 15,25 10.5,28 12,23 8,20 13,20' transform='scale(0.45) translate(165,12)'/>\n    <polygon points='15,15 17,20 22,20 18,23 19.5,28 15,25 10.5,28 12,23 8,20 13,20' transform='scale(0.4) translate(20,170)'/>\n    <polygon points='15,15 17,20 22,20 18,23 19.5,28 15,25 10.5,28 12,23 8,20 13,20' transform='scale(0.5) translate(160,175)'/>\n  </g>\n</svg>", "tags": ["snowflake", "smiling face", "weather", "sky"]}