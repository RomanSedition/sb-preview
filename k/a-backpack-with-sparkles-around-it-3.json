{"id": "sketch-a-backpack-with-sparkles-around-it-3", "title": "Sparkly backpack", "blurb": "", "svg": "<svg viewBox='0 0 100 100' xmlns='http://www.w3.org/2000/svg'>\n  <!-- backpack body -->\n  <rect x='28' y='30' width='44' height='50' rx='12' fill='#e05a3a'/>\n  <!-- body highlight/lighter shade -->\n  <rect x='32' y='34' width='36' height='42' rx='9' fill='#f07a58'/>\n  <!-- top lid -->\n  <path d='M30 42 Q30 26 50 26 Q70 26 70 42 Z' fill='#c8452a'/>\n  <path d='M34 40 Q34 30 50 30 Q66 30 66 40 Z' fill='#e05a3a'/>\n  <!-- front pocket -->\n  <rect x='36' y='56' width='28' height='18' rx='6' fill='#c8452a'/>\n  <rect x='39' y='59' width='22' height='12' rx='4' fill='#f07a58'/>\n  <!-- zipper pocket line -->\n  <rect x='36' y='54' width='28' height='3' rx='1.5' fill='#ffd166'/>\n  <!-- straps -->\n  <path d='M36 30 Q30 22 32 14' stroke='#c8452a' stroke-width='5' fill='none' stroke-linecap='round'/>\n  <path d='M64 30 Q70 22 68 14' stroke='#c8452a' stroke-width='5' fill='none' stroke-linecap='round'/>\n  <!-- buckle -->\n  <rect x='46' y='44' width='8' height='6' rx='1.5' fill='#ffd166'/>\n  <!-- sparkles -->\n  <g fill='#ffe066'>\n    <path d='M18 24 l2 5 5 2 -5 2 -2 5 -2 -5 -5 -2 5 -2 z'/>\n    <path d='M82 20 l1.5 4 4 1.5 -4 1.5 -1.5 4 -1.5 -4 -4 -1.5 4 -1.5 z'/>\n    <path d='M80 62 l2 5 5 2 -5 2 -2 5 -2 -5 -5 -2 5 -2 z'/>\n    <path d='M14 58 l1.5 4 4 1.5 -4 1.5 -1.5 4 -1.5 -4 -4 -1.5 4 -1.5 z'/>\n    <path d='M50 14 l1.5 4 4 1.5 -4 1.5 -1.5 4 -1.5 -4 -4 -1.5 4 -1.5 z'/>\n    <path d='M86 84 l1.5 4 4 1.5 -4 1.5 -1.5 4 -1.5 -4 -4 -1.5 4 -1.5 z'/>\n    <path d='M12 86 l1.5 4 4 1.5 -4 1.5 -1.5 4 -1.5 -4 -4 -1.5 4 -1.5 z'/>\n  </g>\n  <!-- small white sparkle accents -->\n  <g fill='#ffffff'>\n    <circle cx='20' cy='40' r='1.5'/>\n    <circle cx='84' cy='44' r='1.5'/>\n    <circle cx='30' cy='90' r='1.5'/>\n    <circle cx='72' cy='90' r='1.5'/>\n    <circle cx='50' cy='88' r='1.5'/>\n  </g>\n</svg>", "tags": ["backpack", "sparkles", "sparkly", "clothes"]}